#: polyhost/gui/problem_alert_dialog.py:53
msgid "Everything may still be working, but this is worth a look. A bug report collects the logs and pre-fills a GitHub issue; nothing is sent until you press Submit there. To change what is watched, see the problem_scan settings."
msgstr "Wszystko może nadal działać, ale warto się temu przyjrzeć. Zgłoszenie błędu zbiera dzienniki i wstępnie wypełnia zgłoszenie w serwisie GitHub; nic nie zostanie wysłane, dopóki nie klikniesz tam Submit. Aby zmienić, co jest monitorowane, zobacz ustawienia problem_scan."

#: polyhost/gui/problem_alert_dialog.py:65
msgid "Report a Problem…"
msgstr "Zgłoś problem…"

#: polyhost/gui/problem_alert_dialog.py:100
#, python-brace-format
msgid "<b>PolyKybd noticed {n} problem.</b>"
msgid_plural "<b>PolyKybd noticed {n} problems.</b>"
msgstr[0] "<b>PolyKybd wykryła {n} problem.</b>"
msgstr[1] "<b>PolyKybd wykryła {n} problemy.</b>"
msgstr[2] "<b>PolyKybd wykryła {n} problemów.</b>"

#: polyhost/gui/problem_alert_dialog.py:117
msgid "Opened the problem report with these filled in."
msgstr "Otwarto zgłoszenie problemu z wypełnionymi danymi."

#: polyhost/gui/report_problem_dialog.py:53
msgid "Report a Problem"
msgstr "Zgłoś problem"

#: polyhost/gui/report_problem_dialog.py:58
msgid "This collects your logs and opens a pre-filled bug report on GitHub. Nothing is sent anywhere until you press Submit there — and you attach the log file yourself, so you can look at it first."
msgstr "Zbiera dzienniki i otwiera wstępnie wypełnione zgłoszenie błędu w serwisie GitHub. Nic nie jest nigdzie wysyłane, dopóki nie klikniesz tam Submit — a plik dziennika dołączasz samodzielnie, więc możesz go najpierw przejrzeć."

#: polyhost/gui/report_problem_dialog.py:66
msgid "What went wrong? What were you doing when it happened?"
msgstr "Co poszło nie tak? Co robiłeś(-aś), gdy to się stało?"

#: polyhost/gui/report_problem_dialog.py:69
msgid "What happened"
msgstr "Co się stało"

#: polyhost/gui/report_problem_dialog.py:73
msgid "Optional — what you expected instead"
msgstr "Opcjonalnie — czego oczekiwałeś(-aś) zamiast tego"

#: polyhost/gui/report_problem_dialog.py:81
msgid "Include logs from:"
msgstr "Dołącz dzienniki z okresu:"

#: polyhost/gui/report_problem_dialog.py:86
msgid "Mask window titles (recommended)"
msgstr "Maskuj tytuły okien (zalecane)"

#: polyhost/gui/report_problem_dialog.py:102
msgid "Show Log File"
msgstr "Pokaż plik dziennika"

#: polyhost/gui/report_problem_dialog.py:108
msgid "Create Report…"
msgstr "Utwórz zgłoszenie…"

#: polyhost/gui/report_problem_dialog.py:134
msgid "Window titles are replaced with placeholders. Application names are kept — that is what overlay problems are diagnosed from."
msgstr "Tytuły okien są zastępowane symbolami zastępczymi. Nazwy aplikacji są zachowywane — na ich podstawie diagnozuje się problemy z nakładkami."

#: polyhost/gui/report_problem_dialog.py:139
msgid "The log file will contain the titles of windows you had open, which can name documents."
msgstr "Plik dziennika będzie zawierał tytuły otwartych okien, które mogą zawierać nazwy dokumentów."

#: polyhost/gui/report_problem_dialog.py:141
msgid "Only untick this if the problem is about the wrong overlay appearing for an app."
msgstr "Odznacz to tylko wtedy, gdy problem dotyczy wyświetlania niewłaściwej nakładki dla aplikacji."

#: polyhost/gui/report_problem_dialog.py:202
msgid "Collecting logs…"
msgstr "Zbieranie dzienników…"

#: polyhost/gui/report_problem_dialog.py:252
msgid "The report itself is fine — it just has no logs attached."
msgstr "Samo zgłoszenie jest w porządku — po prostu nie ma dołączonych dzienników."

#: polyhost/gui/report_problem_dialog.py:254
msgid "A GitHub issue has been opened in your browser."
msgstr "W przeglądarce otwarto zgłoszenie w serwisie GitHub."

#: polyhost/gui/report_problem_dialog.py:255
msgid "A GitHub issue has been opened in your browser — the report is on your clipboard, paste it in."
msgstr "W przeglądarce otwarto zgłoszenie w serwisie GitHub — raport jest w schowku, wklej go."

#: polyhost/gui/report_problem_dialog.py:261
#, python-brace-format
msgid "Could not open your browser — the report is on your clipboard. <a href='{url}'>Open an issue</a> and paste it in."
msgstr "Nie można otworzyć przeglądarki — raport jest w schowku. <a href='{url}'>Otwórz zgłoszenie</a> i wklej go."

#: polyhost/gui/report_problem_dialog.py:265
msgid "<b>Attach the log file</b> (button on the left reveals it) and press Submit."
msgstr "<b>Dołącz plik dziennika</b> (pokazuje go przycisk po lewej) i kliknij Submit."

#: polyhost/gui/report_problem_dialog.py:268
msgid "Press Submit. (No log file was produced — see above.)"
msgstr "Kliknij Submit. (Nie utworzono pliku dziennika — patrz wyżej.)"

