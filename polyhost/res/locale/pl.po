msgstr "uruchamianie"

#: polyhost/forwarder.py:780
msgid "<b>Mode:</b> forwarder — no keyboard attached to this machine"
msgstr "<b>Tryb:</b> przekaźnik — do tego komputera nie podłączono klawiatury"

#: polyhost/forwarder.py:781
#, python-brace-format
msgid "<b>Target:</b> {target}"
msgstr "<b>Cel:</b> {target}"

#: polyhost/forwarder.py:783
#, python-brace-format
msgid "<b>Window reports:</b> {transport}"
msgstr "<b>Raporty okien:</b> {transport}"

#: polyhost/forwarder.py:786
#, python-brace-format
msgid "<b>Host file:</b> {path}"
msgstr "<b>Plik hosta:</b> {path}"

#: polyhost/forwarder.py:807
msgid "About PolyKybdHost (forwarder)"
msgstr "PolyKybdHost — informacje (przekaźnik)"

#. TRANSLATORS: the run mode in the About dialog's environment line
#: polyhost/forwarder.py:814
msgid "forwarder"
msgstr "przekaźnik"

#: polyhost/forwarder.py:816
msgid "Forwarder mode: this machine has no keyboard. It watches the active window here and relays it to the PolyKybdHost running on the machine the keyboard is plugged into."
msgstr "Tryb przekaźnika: ten komputer nie ma klawiatury. Śledzi tutaj aktywne okno i przekazuje je do PolyKybdHost działającego na komputerze, do którego podłączona jest klawiatura."

#: polyhost/forwarder.py:855
msgid "Download, install, and restart the forwarder now?"
msgstr "Pobrać, zainstalować i ponownie uruchomić przekaźnik teraz?"

#: polyhost/gui/about_dialog.py:40
msgid "Blog"
msgstr "Blog"

#: polyhost/gui/about_dialog.py:66
#, python-brace-format
msgid "Version {version}"
msgstr "Wersja {version}"

#: polyhost/gui/about_dialog.py:97
msgid "About PolyKybdHost"
msgstr "PolyKybdHost — informacje"

#: polyhost/gui/about_dialog.py:141 polyhost/gui/about_dialog.py:151
msgid "Copy diagnostics"
msgstr "Kopiuj diagnostykę"

#: polyhost/gui/about_dialog.py:145
msgid "Copied ✓"
msgstr "Skopiowano ✓"

#: polyhost/gui/boot_loop_dialog.py:25
msgid "Reboots the keyboard again and again to catch an intermittent boot hang. After each reboot it waits for the keyboard to come back and reads its crash record. It stops at the first boot that left a fresh crash record, at a boot that does not come back within a minute, or after the last round.<br><br>The keyboard does not type while this runs, and each round takes a few seconds."
msgstr "Wielokrotnie uruchamia klawiaturę ponownie, aby wychwycić sporadyczne zawieszenie podczas rozruchu. Po każdym ponownym uruchomieniu czeka, aż klawiatura wróci, i odczytuje jej zapis awarii. Zatrzymuje się przy pierwszym rozruchu, który pozostawił nowy zapis awarii, przy rozruchu, po którym klawiatura nie wraca w ciągu minuty, lub po ostatniej rundzie.<br><br>W trakcie testu klawiatura nie pisze, a każda runda trwa kilka sekund."

#: polyhost/gui/boot_loop_dialog.py:34
msgid "<b>No boot problem found.</b>"
msgstr "<b>Nie wykryto problemu z rozruchem.</b>"

#: polyhost/gui/boot_loop_dialog.py:35
msgid "<b>A boot problem was recorded.</b> The record is above; Copy to Clipboard to report it."
msgstr "<b>Zarejestrowano problem z rozruchem.</b> Zapis znajduje się powyżej; użyj Kopiuj do schowka, aby go zgłosić."

#: polyhost/gui/boot_loop_dialog.py:37
msgid "<b>The keyboard did not come back.</b> Note the status panel, then unplug and replug it and read the crash record."
msgstr "<b>Klawiatura nie wróciła.</b> Zanotuj stan panelu stanu, a następnie odłącz i ponownie podłącz klawiaturę i odczytaj zapis awarii."

