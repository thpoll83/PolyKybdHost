#: polyhost/device/command_ids.py:148
#, python-brace-format
msgid "preset {value}"
msgstr "ustawienie {value}"

#: polyhost/device/command_ids.py:150
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} min"

#: polyhost/device/command_ids.py:151
#, python-brace-format
msgid "{seconds} sec"
msgstr "{seconds} s"

#: polyhost/device/hid_fw_up.py:43
#, python-brace-format
msgid "File is too small ({size} bytes) to be a valid RP2040 firmware image (expected at least 264 bytes for boot2 + ARM vector table)."
msgstr "Plik jest za mały ({size} B), aby był prawidłowym obrazem oprogramowania układowego RP2040 (oczekiwano co najmniej 264 bajtów na boot2 i tablicę wektorów ARM)."

#: polyhost/device/hid_fw_up.py:46
#, python-brace-format
msgid "Invalid RP2040 boot2 CRC32 (file has {stored}, computed {computed}). This does not appear to be a valid RP2040 QMK firmware .bin. Make sure you select the .bin produced by 'qmk compile', not a .uf2, .hex, or other format."
msgstr "Nieprawidłowa suma CRC32 boot2 RP2040 (w pliku {stored}, obliczona {computed}). To nie wygląda na prawidłowy plik .bin oprogramowania układowego QMK dla RP2040. Wybierz plik .bin utworzony przez 'qmk compile', a nie .uf2, .hex ani inny format."

#: polyhost/device/hid_fw_up.py:51
#, python-brace-format
msgid "Invalid ARM vector table: initial SP {sp} is outside RP2040 SRAM ({sram}). This does not appear to be a valid RP2040 firmware binary."
msgstr "Nieprawidłowa tablica wektorów ARM: początkowy SP {sp} leży poza SRAM RP2040 ({sram}). To nie wygląda na prawidłowy plik binarny oprogramowania układowego RP2040."

#: polyhost/device/hid_fw_up.py:54
msgid "This firmware binary does not appear to be built for PolyKybd. No PolyKybd identifier string was found in the binary. Make sure you selected a firmware compiled for 'polykybd/split72' using 'qmk compile'."
msgstr "Ten plik binarny oprogramowania układowego nie wygląda na zbudowany dla PolyKybd. Nie znaleziono w nim ciągu identyfikującego PolyKybd. Wybierz oprogramowanie skompilowane dla 'polykybd/split72' za pomocą 'qmk compile'."

#: polyhost/device/hid_fw_up.py:59
#, python-brace-format
msgid ""
"No signature file was found next to this image ({sig}).\n"
"\n"
"The keyboard will ask you to confirm it physically: every keycap goes dark except a big A (accept) on the left half and R (reject) on the right. That is expected for a firmware you built yourself.\n"
"\n"
"If you meant to flash a release, download its '.sig' file into the same folder as the '.bin' first."
msgstr ""
"Obok tego obrazu nie znaleziono pliku podpisu ({sig}).\n"
"\n"
"Klawiatura poprosi o fizyczne potwierdzenie: wszystkie klawisze zgasną z wyjątkiem dużego A (akceptuj) na lewej połówce i R (odrzuć) na prawej. To normalne w przypadku samodzielnie zbudowanego oprogramowania.\n"
"\n"
"Jeśli chodziło o wgranie wydania, najpierw pobierz jego plik '.sig' do tego samego folderu co plik '.bin'."

#: polyhost/device/hid_fw_up.py:65
#, python-brace-format
msgid "Cannot read {sig}: {error}"
msgstr "Nie można odczytać {sig}: {error}"

#: polyhost/device/hid_fw_up.py:67
#, python-brace-format
msgid "{sig} is {size} bytes, but a signature is exactly {expected}. It will be ignored and the keyboard will ask you to confirm the image physically."
msgstr "{sig} ma {size} B, a podpis ma dokładnie {expected}. Plik zostanie zignorowany, a klawiatura poprosi o fizyczne potwierdzenie obrazu."

#: polyhost/device/hid_fw_up.py:69
msgid "Firmware file is empty."
msgstr "Plik oprogramowania układowego jest pusty."

#: polyhost/device/hid_fw_up.py:70
#, python-brace-format
msgid "Firmware too large: {size} bytes (max {max_kb} KB)."
msgstr "Oprogramowanie układowe jest za duże: {size} B (maks. {max_kb} KB)."

#: polyhost/device/hid_fw_up.py:71
#, python-brace-format
msgid "Sending FW_UP_BEGIN — {kb} KB, CRC32 {crc}…"
msgstr "Wysyłanie FW_UP_BEGIN — {kb} KB, CRC32 {crc}…"

#: polyhost/device/hid_fw_up.py:72
#, python-brace-format
msgid "{step} — {elapsed}s elapsed…"
msgstr "{step} — upłynęło {elapsed} s…"

#: polyhost/device/hid_fw_up.py:73
msgid "Erasing staging area — keyboard will reconnect when done"
msgstr "Wymazywanie obszaru przygotowania — po zakończeniu klawiatura połączy się ponownie"

#: polyhost/device/hid_fw_up.py:74
msgid "Erasing staging area (both halves)"
msgstr "Wymazywanie obszaru przygotowania (obie połówki)"

#: polyhost/device/hid_fw_up.py:75
msgid "FW_UP_BEGIN timed out"
msgstr "Upłynął limit czasu FW_UP_BEGIN"

#: polyhost/device/hid_fw_up.py:76
msgid "staging area"
msgstr "obszar przygotowania"

#: polyhost/device/hid_fw_up.py:78
msgid "FW_UP_BEGIN timed out — keyboard did not finish erasing within 90 s.  Check the USB cable and try again."
msgstr "Upłynął limit czasu FW_UP_BEGIN — klawiatura nie zakończyła wymazywania w ciągu 90 s.  Sprawdź kabel USB i spróbuj ponownie."

#: polyhost/device/hid_fw_up.py:81
msgid "FW_UP_BEGIN failed — keyboard did not reconnect within 30 s.  Check the USB cable and try again."
msgstr "FW_UP_BEGIN nie powiodło się — klawiatura nie połączyła się ponownie w ciągu 30 s.  Sprawdź kabel USB i spróbuj ponownie."

#: polyhost/device/hid_fw_up.py:84
msgid ""
"FW_UP_BEGIN failed — the slave half could not be prepared.\n"
"Ensure both keyboard halves are connected and powered on.\n"
"If the slave half has old firmware (without HID firmware update support), it must be\n"
"flashed manually via UF2 before HID firmware update will work."
msgstr ""
"FW_UP_BEGIN nie powiodło się — nie udało się przygotować połówki podrzędnej.\n"
"Upewnij się, że obie połówki klawiatury są podłączone i włączone.\n"
"Jeśli połówka podrzędna ma stare oprogramowanie (bez obsługi aktualizacji przez HID), trzeba ją\n"
"najpierw wgrać ręcznie przez UF2, zanim aktualizacja przez HID zacznie działać."

#: polyhost/device/hid_fw_up.py:88
#, python-brace-format
msgid "Staging erased. Sending {chunks} chunks…"
msgstr "Obszar przygotowania wymazany. Wysyłanie fragmentów: {chunks}…"

#: polyhost/device/hid_fw_up.py:89
msgid "Update cancelled by user."
msgstr "Aktualizacja anulowana przez użytkownika."

#: polyhost/device/hid_fw_up.py:90
#, python-brace-format
msgid "Chunk {n}/{total} ({kb} KB sent)…"
msgstr "Fragment {n}/{total} (wysłano {kb} KB)…"

#: polyhost/device/hid_fw_up.py:92
#, python-brace-format
msgid "Keyboard halves resynced — rewinding to chunk {n}/{total} (offset {offset}, resync {resync})…"
msgstr "Połówki klawiatury ponownie zsynchronizowane — powrót do fragmentu {n}/{total} (przesunięcie {offset}, synchronizacja {resync})…"

#: polyhost/device/hid_fw_up.py:94
msgid "keyboard rejected the chunk"
msgstr "klawiatura odrzuciła fragment"

#: polyhost/device/hid_fw_up.py:95
msgid "no reply from the keyboard"
msgstr "brak odpowiedzi od klawiatury"

#: polyhost/device/hid_fw_up.py:97
#, python-brace-format
msgid ""
"FW_UP_CHUNK failed at offset {offset} after {attempts} attempts — {reason}.\n"
"Ensure both keyboard halves are connected and running the same firmware, then try again — the update resumes from scratch and is safe to repeat."
msgstr ""
"FW_UP_CHUNK nie powiodło się przy przesunięciu {offset} po {attempts} próbach — {reason}.\n"
"Upewnij się, że obie połówki klawiatury są podłączone i mają to samo oprogramowanie układowe, a następnie spróbuj ponownie — aktualizacja zacznie się od początku i można ją bezpiecznie powtórzyć."

#: polyhost/device/hid_fw_up.py:100
#, python-brace-format
msgid "Chunk {n}/{total} — retry {attempt}/{max_attempts} (waiting {ms} ms)…"
msgstr "Fragment {n}/{total} — ponowienie {attempt}/{max_attempts} (oczekiwanie {ms} ms)…"

#: polyhost/device/hid_fw_up.py:101
#, python-brace-format
msgid "Sending over the fast link: {kb} KB of {total_kb} KB…"
msgstr "Wysyłanie przez szybkie łącze: {kb} KB z {total_kb} KB…"

#: polyhost/device/hid_fw_up.py:102
#, python-brace-format
msgid "Fast link stopped ({reason}); continuing over HID from {kb} KB."
msgstr "Szybkie łącze przerwane ({reason}); kontynuacja przez HID od {kb} KB."

#: polyhost/device/hid_fw_up.py:106
msgid "port not openable"
msgstr "nie można otworzyć portu"

#: polyhost/device/hid_fw_up.py:107
msgid "pipe protocol too old"
msgstr "protokół kanału jest za stary"

#: polyhost/device/hid_fw_up.py:108
msgid "port error"
msgstr "błąd portu"

#: polyhost/device/hid_fw_up.py:109
#, python-brace-format
msgid "Could not read {sig}: {error} — flashing unsigned."
msgstr "Nie można odczytać {sig}: {error} — wgrywanie bez podpisu."

#: polyhost/device/hid_fw_up.py:110
msgid "Sending image signature…"
msgstr "Wysyłanie podpisu obrazu…"

#: polyhost/device/hid_fw_up.py:111
#, python-brace-format
msgid "Ignoring {sig} — expected {expected} bytes, got {size}."
msgstr "Pomijanie {sig} — oczekiwano {expected} B, otrzymano {size}."

#: polyhost/device/hid_fw_up.py:112
msgid "Verifying the staged image (CRC32)…"
msgstr "Weryfikowanie przygotowanego obrazu (CRC32)…"

#: polyhost/device/hid_fw_up.py:114
msgid "This firmware is not signed. Confirm on the KEYBOARD: press the highlighted A (accept) or R (reject) key."
msgstr "To oprogramowanie układowe nie jest podpisane. Potwierdź na KLAWIATURZE: naciśnij podświetlony klawisz A (akceptuj) lub R (odrzuć)."

#: polyhost/device/hid_fw_up.py:117
msgid ""
"Timed out waiting for confirmation on the keyboard.\n"
"\n"
"The keyboard asks for a physical ACCEPT/REJECT because this image is not validly signed. Start the flash again and press the highlighted A key on the left half within a minute."
msgstr ""
"Upłynął limit czasu oczekiwania na potwierdzenie na klawiaturze.\n"
"\n"
"Klawiatura wymaga fizycznego potwierdzenia ACCEPT/REJECT, ponieważ ten obraz nie ma prawidłowego podpisu. Rozpocznij wgrywanie ponownie i w ciągu minuty naciśnij podświetlony klawisz A na lewej połówce."

#: polyhost/device/hid_fw_up.py:122
#, python-brace-format
msgid ""
"The keyboard refused this firmware: the signature does not match the image.\n"
"\n"
"{sig} is not a valid signature for this .bin. Either the two files come from different builds, or one of them is damaged — re-download both from the same release.\n"
"\n"
"There is deliberately no way to confirm past this on the keyboard: a signature that fails to verify means the file is not what it claims to be."
msgstr ""
"Klawiatura odrzuciła to oprogramowanie układowe: podpis nie pasuje do obrazu.\n"
"\n"
"{sig} nie jest prawidłowym podpisem dla tego pliku .bin. Albo oba pliki pochodzą z różnych kompilacji, albo jeden z nich jest uszkodzony — pobierz ponownie oba z tego samego wydania.\n"
"\n"
"Celowo nie ma sposobu, by to obejść potwierdzeniem na klawiaturze: podpis, którego nie da się zweryfikować, oznacza, że plik nie jest tym, za co się podaje."

#: polyhost/device/hid_fw_up.py:131
msgid ""
"The keyboard refused this firmware: it is not signed.\n"
"\n"
"Released firmware ships a matching '.sig' file — download it next to the .bin and flash again.\n"
"\n"
"To flash a build you compiled yourself, flash again and press the highlighted A (accept) key on the keyboard when it asks."
msgstr ""
"Klawiatura odrzuciła to oprogramowanie układowe: nie jest podpisane.\n"
"\n"
"Wydane oprogramowanie jest dostarczane z pasującym plikiem '.sig' — pobierz go obok pliku .bin i wgraj ponownie.\n"
"\n"
"Aby wgrać samodzielnie skompilowaną wersję, wgraj ponownie i naciśnij podświetlony klawisz A (akceptuj) na klawiaturze, gdy o to poprosi."

#: polyhost/device/hid_fw_up.py:136
msgid "FW_UP_COMMIT failed — CRC mismatch on keyboard. Try again."
msgstr "FW_UP_COMMIT nie powiodło się — niezgodność CRC na klawiaturze. Spróbuj ponownie."

#: polyhost/device/hid_fw_up.py:137
msgid "Done. New firmware staged and verified on the keyboard."
msgstr "Gotowe. Nowe oprogramowanie układowe przygotowane i zweryfikowane na klawiaturze."

#: polyhost/device/hid_fw_up.py:139
msgid ""
"Firmware staged and verified successfully.\n"
"\n"
"The new image is stored and CRC-checked on the keyboard, but it is not active yet — the keyboard is still running its current firmware. Activating the staged image will be a separate step."
msgstr ""
"Oprogramowanie układowe zostało pomyślnie przygotowane i zweryfikowane.\n"
"\n"
"Nowy obraz jest zapisany na klawiaturze i sprawdzony sumą CRC, ale nie jest jeszcze aktywny — klawiatura nadal działa na bieżącym oprogramowaniu. Aktywacja przygotowanego obrazu to osobny krok."

#: polyhost/device/hid_fw_up.py:143
msgid "Sending FW_UP_APPLY…"
msgstr "Wysyłanie FW_UP_APPLY…"

#: polyhost/device/hid_fw_up.py:145
msgid ""
"Apply is not available.\n"
"\n"
"The keyboard reported no valid staged image, or this firmware was built without in-app apply (FW_UP_INAPP_APPLY=no). The staged image is unchanged."
msgstr ""
"Zastosowanie jest niedostępne.\n"
"\n"
"Klawiatura zgłosiła brak prawidłowego przygotowanego obrazu albo to oprogramowanie zbudowano bez zastosowania z aplikacji (FW_UP_INAPP_APPLY=no). Przygotowany obraz nie został zmieniony."

#: polyhost/device/hid_fw_up.py:149
msgid "Applying — keyboard is erasing its flash and rebooting…"
msgstr "Stosowanie — klawiatura wymazuje pamięć flash i uruchamia się ponownie…"

#: polyhost/device/hid_fw_up.py:151
msgid ""
"Keyboard did not reconnect within 30 s after apply.\n"
"If it does not come back on its own, hold BOOTSEL on the master half and re-flash the .uf2."
msgstr ""
"Klawiatura nie połączyła się ponownie w ciągu 30 s po zastosowaniu.\n"
"Jeśli nie wróci sama, przytrzymaj BOOTSEL na połówce nadrzędnej i wgraj ponownie plik .uf2."

#: polyhost/device/hid_fw_up.py:155
msgid ""
"The keyboard acknowledged APPLY but did not reboot within 10 s.\n"
"The staged image was not applied; the keyboard still runs its current firmware. Try the apply again."
msgstr ""
"Klawiatura potwierdziła APPLY, ale nie uruchomiła się ponownie w ciągu 10 s.\n"
"Przygotowany obraz nie został zastosowany; klawiatura nadal działa na bieżącym oprogramowaniu. Spróbuj zastosować ponownie."

#: polyhost/device/hid_fw_up.py:158
msgid "Done. Keyboard reconnected on the applied firmware."
msgstr "Gotowe. Klawiatura połączyła się ponownie z zastosowanym oprogramowaniem."

#: polyhost/device/hid_fw_up.py:160
msgid ""
"Firmware applied — the keyboard rebooted and reconnected.\n"
"\n"
"Both halves now run the new firmware."
msgstr ""
"Oprogramowanie układowe zastosowane — klawiatura uruchomiła się ponownie i połączyła.\n"
"\n"
"Obie połówki działają teraz na nowym oprogramowaniu."

#: polyhost/device/split_link.py:30
#, python-brace-format
msgid "{prefix} — the USB half answered, but the other keyboard half did not confirm that it had erased the {what} within 90 s. Check the cable between the two halves. If the other half stays dark, it is not running firmware and needs the firmware .uf2 copied onto it by hand."
msgstr "{prefix} — połówka z USB odpowiedziała, ale druga połówka klawiatury nie potwierdziła, że wymazała {what} w ciągu 90 s. Sprawdź kabel między połówkami. Jeśli druga połówka pozostaje ciemna, nie działa na niej oprogramowanie i trzeba ręcznie skopiować na nią plik .uf2 oprogramowania układowego."

