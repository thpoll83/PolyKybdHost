msgid "Close"
msgstr "Zavřít"

#: polyhost/gui/boot_loop_dialog.py:113
#, python-brace-format
msgid "Could not start: {error}"
msgstr "Nelze spustit: {error}"

#: polyhost/gui/boot_loop_dialog.py:115
#, python-brace-format
msgid "Started: up to {n} reboot(s)."
msgid_plural "Started: up to {n} reboot(s)."
msgstr[0] "Spuštěno: nejvýše {n} restart."
msgstr[1] "Spuštěno: nejvýše {n} restarty."
msgstr[2] "Spuštěno: nejvýše {n} restartů."

