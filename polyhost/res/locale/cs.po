#: polyhost/gui/boot_loop_dialog.py:25
msgid "Reboots the keyboard again and again to catch an intermittent boot hang. After each reboot it waits for the keyboard to come back and reads its crash record. It stops at the first boot that left a fresh crash record, at a boot that does not come back within a minute, or after the last round.<br><br>The keyboard does not type while this runs, and each round takes a few seconds."
msgstr "Opakovaně restartuje klávesnici, aby zachytil občasné zaseknutí při spouštění. Po každém restartu čeká, až se klávesnice znovu ozve, a přečte její záznam o pádu. Zastaví se při prvním spuštění, které zanechalo nový záznam o pádu, při spuštění, které se do minuty neozve, nebo po posledním kole.<br><br>Během testu klávesnice nepíše a každé kolo trvá několik sekund."

#: polyhost/gui/boot_loop_dialog.py:34
msgid "<b>No boot problem found.</b>"
msgstr "<b>Nebyl nalezen žádný problém se spouštěním.</b>"

#: polyhost/gui/boot_loop_dialog.py:35
msgid "<b>A boot problem was recorded.</b> The record is above; Copy to Clipboard to report it."
msgstr "<b>Byl zaznamenán problém se spouštěním.</b> Záznam je výše; nahlaste ho pomocí tlačítka Kopírovat do schránky."

#: polyhost/gui/boot_loop_dialog.py:37
msgid "<b>The keyboard did not come back.</b> Note the status panel, then unplug and replug it and read the crash record."
msgstr "<b>Klávesnice se znovu neozvala.</b> Poznamenejte si stavový panel, pak ji odpojte, znovu připojte a přečtěte záznam o pádu."

#: polyhost/gui/boot_loop_dialog.py:39
msgid "Stopped."
msgstr "Zastaveno."

#: polyhost/gui/boot_loop_dialog.py:49
msgid "PolyKybd — boot-loop test"
msgstr "PolyKybd — test opakovaného spouštění"

#: polyhost/gui/boot_loop_dialog.py:58
msgid "Reboots:"
msgstr "Restarty:"

#: polyhost/gui/boot_loop_dialog.py:78
msgid "Start"
msgstr "Spustit"

#: polyhost/gui/boot_loop_dialog.py:82
#: polyhost/gui/layout_dialog/macro_steps_dialog.py:487
msgid "Stop"
msgstr "Zastavit"

