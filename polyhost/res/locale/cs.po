msgstr "Pro aktualizaci firmwaru musí být klávesnice připojena."

#: polyhost/host.py:2861
#, python-brace-format
msgid "Firmware {version} is available."
msgstr "Je k dispozici firmware {version}."

#: polyhost/host.py:2863
msgid "Both halves update over HID and reboot automatically."
msgstr "Obě poloviny se aktualizují přes HID a automaticky se restartují."

