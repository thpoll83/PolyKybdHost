msgstr "Загрузить, установить и перезапустить модуль пересылки сейчас?"

#: polyhost/gui/about_dialog.py:40
msgid "Blog"
msgstr "Блог"

#: polyhost/gui/about_dialog.py:66
#, python-brace-format
msgid "Version {version}"
msgstr "Версия {version}"

#: polyhost/gui/about_dialog.py:97
msgid "About PolyKybdHost"
msgstr "О программе PolyKybdHost"

