msgstr "Недопустимый файл микропрограммы"

#: polyhost/gui/cmd_menu.py:526
msgid "Wrong Keyboard"
msgstr "Не та клавиатура"

#: polyhost/gui/cmd_menu.py:536
msgid "Unsigned Firmware"
msgstr "Неподписанная микропрограмма"

#: polyhost/gui/cmd_menu.py:541
msgid "Flash + Apply Firmware"
msgstr "Прошить и применить микропрограмму"

#: polyhost/gui/cmd_menu.py:543
msgid "This will transfer the new firmware to the keyboard, verify it (CRC32), then <b>activate it</b> — both halves reboot onto the new firmware automatically (no replug needed)."
msgstr "Новая микропрограмма будет передана на клавиатуру, проверена (CRC32), а затем <b>активирована</b> — обе половины автоматически перезагрузятся с новой микропрограммой (переподключать не нужно)."

#: polyhost/gui/cmd_menu.py:548
msgid "Flash Firmware"
msgstr "Прошивка микропрограммы"

#: polyhost/gui/cmd_menu.py:550
msgid "This will transfer and stage the new firmware on the keyboard, then verify it (CRC32). The image is stored but <b>not activated yet</b> — the keyboard keeps running its current firmware until you apply it separately."
msgstr "Новая микропрограмма будет передана на клавиатуру и подготовлена, а затем проверена (CRC32). Образ сохраняется, но <b>пока не активируется</b> — клавиатура продолжит работать на текущей микропрограмме, пока вы не примените новую отдельно."

#: polyhost/gui/cmd_menu.py:568
#, python-brace-format
msgid "Current keyboard firmware: <b>{version}</b> ({size_kb} KB)"
msgstr "Текущая микропрограмма клавиатуры: <b>{version}</b> ({size_kb} KB)"

#: polyhost/gui/cmd_menu.py:571
msgid "Could not query current firmware version."
msgstr "Не удалось запросить версию текущей микропрограммы."

#: polyhost/gui/cmd_menu.py:572
#, python-brace-format
msgid "Selected file:<br>{path}"
msgstr "Выбранный файл:<br>{path}"

#: polyhost/gui/cmd_menu.py:573
msgid "Continue?"
msgstr "Продолжить?"

#: polyhost/gui/cmd_menu.py:601
msgid "<b>Apply the staged firmware?</b><br><br>Both keyboard halves will install the previously-staged image and reboot onto the new firmware automatically (no replug needed).<br><br>If this firmware was not built with in-app apply enabled, the keyboard safely reports apply unavailable and leaves the staged image untouched.<br><br>Continue?"
msgstr "<b>Применить подготовленную микропрограмму?</b><br><br>Обе половины клавиатуры установят ранее подготовленный образ и автоматически перезагрузятся с новой микропрограммой (переподключать не нужно).<br><br>Если эта микропрограмма собрана без поддержки применения из приложения, клавиатура безопасно сообщит, что применение недоступно, и оставит подготовленный образ нетронутым.<br><br>Продолжить?"

#: polyhost/gui/cmd_menu.py:610
msgid "Apply Staged Firmware"
msgstr "Применение подготовленной микропрограммы"

#: polyhost/gui/cmd_menu.py:635
msgid "Firmware Applied"
msgstr "Микропрограмма применена"

#: polyhost/gui/cmd_menu.py:637
msgid "Apply Failed"
msgstr "Ошибка применения"

