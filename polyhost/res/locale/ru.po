#: polyhost/gui/newer_firmware_dialog.py:32
msgid "Safe mode"
msgstr "Безопасный режим"

#: polyhost/gui/newer_firmware_dialog.py:33
msgid "Check for updates"
msgstr "Проверить обновления"

#: polyhost/gui/newer_firmware_dialog.py:34
msgid "Connect anyway"
msgstr "Всё равно подключиться"

#: polyhost/gui/newer_firmware_dialog.py:57
#, python-brace-format
msgid "{keyboard}'s firmware (protocol P{device_protocol}) is newer than this host app (protocol P{host_protocol})."
msgstr "Микропрограмма {keyboard} (протокол P{device_protocol}) новее этого приложения (протокол P{host_protocol})."

#: polyhost/gui/newer_firmware_dialog.py:61
msgid "A newer firmware may use commands this version of the app doesn't fully understand, so some features could misbehave. How would you like to proceed?"
msgstr "Более новая микропрограмма может использовать команды, которые эта версия приложения не полностью понимает, поэтому некоторые функции могут работать неправильно. Как поступить?"

#: polyhost/gui/newer_firmware_dialog.py:65
msgid "• Safe mode — connect, but enable only the stable set (firmware update and debugging)."
msgstr "• Безопасный режим — подключиться, но включить только стабильный набор функций (обновление микропрограммы и отладка)."

#: polyhost/gui/newer_firmware_dialog.py:67
msgid "• Check for updates — look for a newer host app that matches; if none is found, stay in safe mode."
msgstr "• Проверить обновления — найти подходящую более новую версию приложения; если её нет, остаться в безопасном режиме."

#: polyhost/gui/newer_firmware_dialog.py:69
msgid "• Connect anyway — use everything and accept the risk."
msgstr "• Всё равно подключиться — использовать все функции на свой страх и риск."

#: polyhost/gui/newer_firmware_dialog.py:73
msgid "Newer keyboard firmware detected"
msgstr "Обнаружена более новая микропрограмма клавиатуры"

