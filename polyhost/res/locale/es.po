#: polyhost/gui/newer_firmware_dialog.py:61
#, python-brace-format
msgid "{keyboard}'s firmware (protocol P{device_protocol}) is newer than this host app (protocol P{host_protocol})."
msgstr "El firmware de {keyboard} (protocolo P{device_protocol}) es más reciente que esta aplicación (protocolo P{host_protocol})."

#: polyhost/gui/newer_firmware_dialog.py:65
msgid "A newer firmware may use commands this version of the app doesn't fully understand, so some features could misbehave. How would you like to proceed?"
msgstr "Un firmware más reciente puede usar comandos que esta versión de la aplicación no entiende del todo, por lo que algunas funciones podrían no comportarse correctamente. ¿Cómo desea continuar?"

#: polyhost/gui/newer_firmware_dialog.py:69
msgid "• Safe mode — connect, but enable only the stable set (firmware update and debugging)."
msgstr "• Modo seguro: conectar, pero habilitar solo el conjunto estable (actualización de firmware y depuración)."

#: polyhost/gui/newer_firmware_dialog.py:71
msgid "• Check for updates — look for a newer host app that matches; if none is found, stay in safe mode."
msgstr "• Buscar actualizaciones: buscar una versión más reciente de la aplicación que sea compatible; si no se encuentra ninguna, permanecer en modo seguro."

#: polyhost/gui/newer_firmware_dialog.py:73
msgid "• Connect anyway — use everything and accept the risk."
msgstr "• Conectar de todos modos: usar todo y aceptar el riesgo."

#: polyhost/gui/newer_firmware_dialog.py:77
msgid "Newer keyboard firmware detected"
msgstr "Se detectó un firmware de teclado más reciente"

