#: polyhost/gui/problem_alert_dialog.py:37
msgid "PolyKybd — a problem was detected"
msgstr "PolyKybd — se detectó un problema"

#: polyhost/gui/problem_alert_dialog.py:54
msgid "Everything may still be working, but this is worth a look. A bug report collects the logs and pre-fills a GitHub issue; nothing is sent until you press Submit there. To change what is watched, open Settings → Privacy and diagnostics → Problem detection."
msgstr "Puede que todo siga funcionando, pero conviene revisarlo. Un informe de errores recopila los registros y rellena previamente una incidencia en GitHub; no se envía nada hasta que pulse Enviar allí. Para cambiar lo que se vigila, abra Configuración → Privacidad y diagnóstico → Detección de problemas."

#: polyhost/gui/problem_alert_dialog.py:65
msgid "Report a Problem…"
msgstr "Informar de un problema…"

#: polyhost/gui/problem_alert_dialog.py:100
#, python-brace-format
msgid "<b>PolyKybd noticed {n} problem.</b>"
msgid_plural "<b>PolyKybd noticed {n} problems.</b>"
msgstr[0] "<b>PolyKybd detectó {n} problema.</b>"
msgstr[1] "<b>PolyKybd detectó {n} problemas.</b>"

#: polyhost/gui/problem_alert_dialog.py:118
msgid "Opened the problem report with these filled in."
msgstr "Se abrió el informe de problemas con estos datos rellenados."

#: polyhost/gui/report_problem_dialog.py:54
msgid "Report a Problem"
msgstr "Informar de un problema"

#: polyhost/gui/report_problem_dialog.py:59
msgid "This collects your logs and opens a pre-filled bug report on GitHub. Nothing is sent anywhere until you press Submit there — and you attach the log file yourself, so you can look at it first."
msgstr "Esto recopila sus registros y abre un informe de errores prerrellenado en GitHub. No se envía nada hasta que pulse Enviar allí, y usted mismo adjunta el archivo de registro, así que puede revisarlo antes."

#: polyhost/gui/report_problem_dialog.py:67
msgid "What went wrong? What were you doing when it happened?"
msgstr "¿Qué salió mal? ¿Qué estaba haciendo cuando ocurrió?"

#: polyhost/gui/report_problem_dialog.py:70
msgid "What happened"
msgstr "Qué ocurrió"

#: polyhost/gui/report_problem_dialog.py:74
msgid "Optional — what you expected instead"
msgstr "Opcional: lo que esperaba que ocurriera"

#: polyhost/gui/report_problem_dialog.py:82
msgid "Include logs from:"
msgstr "Incluir registros de:"

#: polyhost/gui/report_problem_dialog.py:87
msgid "Mask window titles (recommended)"
msgstr "Ocultar títulos de ventana (recomendado)"

#: polyhost/gui/report_problem_dialog.py:103
msgid "Show Log File"
msgstr "Mostrar archivo de registro"

#: polyhost/gui/report_problem_dialog.py:109
msgid "Create Report…"
msgstr "Crear informe…"

#: polyhost/gui/report_problem_dialog.py:135
msgid "Window titles are replaced with placeholders. Application names are kept — that is what overlay problems are diagnosed from."
msgstr "Los títulos de ventana se sustituyen por marcadores. Se conservan los nombres de las aplicaciones, que es lo que sirve para diagnosticar problemas de superposiciones."

#: polyhost/gui/report_problem_dialog.py:140
msgid "The log file will contain the titles of windows you had open, which can name documents."
msgstr "El archivo de registro contendrá los títulos de las ventanas que tenía abiertas, que pueden mostrar los nombres de documentos."

#: polyhost/gui/report_problem_dialog.py:142
msgid "Only untick this if the problem is about the wrong overlay appearing for an app."
msgstr "Desmarque esto solo si el problema es que aparece una superposición incorrecta para una aplicación."

#: polyhost/gui/report_problem_dialog.py:203
msgid "Collecting logs…"
msgstr "Recopilando registros…"

#: polyhost/gui/report_problem_dialog.py:253
msgid "The report itself is fine — it just has no logs attached."
msgstr "El informe en sí está bien; simplemente no tiene registros adjuntos."

#: polyhost/gui/report_problem_dialog.py:255
msgid "A GitHub issue has been opened in your browser."
msgstr "Se ha abierto una incidencia de GitHub en su navegador."

#: polyhost/gui/report_problem_dialog.py:256
msgid "A GitHub issue has been opened in your browser — the report is on your clipboard, paste it in."
msgstr "Se ha abierto una incidencia de GitHub en su navegador; el informe está en el portapapeles, péguelo allí."

#: polyhost/gui/report_problem_dialog.py:262
#, python-brace-format
msgid "Could not open your browser — the report is on your clipboard. <a href='{url}'>Open an issue</a> and paste it in."
msgstr "No se pudo abrir el navegador; el informe está en el portapapeles. <a href='{url}'>Abra una incidencia</a> y péguelo allí."

#: polyhost/gui/report_problem_dialog.py:266
msgid "<b>Attach the log file</b> (button on the left reveals it) and press Submit."
msgstr "<b>Adjunte el archivo de registro</b> (el botón de la izquierda lo muestra) y pulse Enviar."

#: polyhost/gui/report_problem_dialog.py:269
msgid "Press Submit. (No log file was produced — see above.)"
msgstr "Pulse Enviar. (No se generó ningún archivo de registro; consulte arriba.)"

