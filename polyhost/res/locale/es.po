msgstr "Copiar diagnóstico"

#: polyhost/gui/about_dialog.py:156
msgid "Copied ✓"
msgstr "Copiado ✓"

#: polyhost/gui/agent_hooks.py:23 polyhost/gui/agent_hooks.py:35
msgid "Set Up Hooks"
msgstr "Configurar hooks"

#: polyhost/gui/agent_hooks.py:44
msgid "The hooks are already set up."
msgstr "Los hooks ya están configurados."

#: polyhost/gui/agent_hooks.py:47
#, python-brace-format
msgid "Write the PolyKybd hooks into {files}? Your own hooks are kept, and a copy of each file is saved as <file>.polykybd.bak."
msgstr "¿Escribir los hooks de PolyKybd en {files}? Sus propios hooks se conservan y se guarda una copia de cada archivo como <file>.polykybd.bak."

#: polyhost/gui/boot_loop_dialog.py:26
msgid "Reboots the keyboard again and again to catch an intermittent boot hang. After each reboot it waits for the keyboard to come back and reads its crash record. It stops at the first boot that left a fresh crash record, at a boot that does not come back within a minute, or after the last round.<br><br>The keyboard does not type while this runs, and each round takes a few seconds."
msgstr "Reinicia el teclado una y otra vez para detectar un bloqueo intermitente durante el arranque. Tras cada reinicio espera a que el teclado vuelva y lee su registro de fallos. Se detiene en el primer arranque que deje un registro de fallos nuevo, en un arranque del que no vuelva en un minuto o tras la última ronda.<br><br>El teclado no escribe mientras se ejecuta, y cada ronda tarda unos segundos."

#: polyhost/gui/boot_loop_dialog.py:35
msgid "<b>No boot problem found.</b>"
msgstr "<b>No se encontró ningún problema de arranque.</b>"

#: polyhost/gui/boot_loop_dialog.py:36
msgid "<b>A boot problem was recorded.</b> The record is above; Copy to Clipboard to report it."
msgstr "<b>Se registró un problema de arranque.</b> El registro aparece arriba; use Copiar al portapapeles para informar de él."

#: polyhost/gui/boot_loop_dialog.py:38
msgid "<b>The keyboard did not come back.</b> Note the status panel, then unplug and replug it and read the crash record."
msgstr "<b>El teclado no volvió.</b> Anote lo que muestra el panel de estado, desconéctelo y vuelva a conectarlo, y lea el registro de fallos."

#: polyhost/gui/boot_loop_dialog.py:40
msgid "Stopped."
msgstr "Detenido."

#: polyhost/gui/boot_loop_dialog.py:50
msgid "PolyKybd — boot-loop test"
msgstr "PolyKybd — prueba de bucle de arranque"

#: polyhost/gui/boot_loop_dialog.py:59
msgid "Reboots:"
msgstr "Reinicios:"

#: polyhost/gui/boot_loop_dialog.py:79
msgid "Start"
msgstr "Iniciar"

#: polyhost/gui/boot_loop_dialog.py:84
#: polyhost/gui/layout_dialog/macro_steps_dialog.py:491
msgid "Stop"
msgstr "Detener"

#: polyhost/gui/boot_loop_dialog.py:89 polyhost/gui/crash_alert_dialog.py:77
#: polyhost/gui/error_dialog.py:50 polyhost/gui/log_bundle_dialog.py:167
#: polyhost/gui/problem_alert_dialog.py:70
msgid "Copy to Clipboard"
