#: polyhost/host.py:3780 polyhost/host.py:3794 polyhost/host.py:3840
#: polyhost/host.py:3849 polyhost/host.py:3855
msgid "Install WinCompose"
msgstr "Instalar WinCompose"

#: polyhost/host.py:3781
msgid ""
"WinCompose lets your PolyKybd type any unicode character on Windows — emoji, accents and the language layers all go through it. Without it the keyboard falls back to the far more limited native Windows input.\n"
"\n"
"PolyKybd's build of WinCompose will be downloaded from GitHub and its installer started (Windows will ask you to confirm)."
msgstr ""
"WinCompose permite que su PolyKybd escriba cualquier carácter Unicode en Windows: los emoji, los acentos y las capas de idioma pasan por él. Sin él, el teclado recurre a la entrada nativa de Windows, mucho más limitada.\n"
"\n"
"Se descargará de GitHub la versión de WinCompose de PolyKybd y se iniciará su instalador (Windows le pedirá confirmación)."

#: polyhost/host.py:3794
msgid "Looking for the latest WinCompose release…"
msgstr "Buscando la versión más reciente de WinCompose…"

#: polyhost/host.py:3841
msgid ""
"No ready-made installer was found for download.\n"
"\n"
"The releases page will open in your browser — download and run the setup from there."
msgstr ""
"No se encontró ningún instalador listo para descargar.\n"
"\n"
"La página de versiones se abrirá en su navegador; descargue y ejecute el instalador desde allí."

#: polyhost/host.py:3850
#, python-brace-format
msgid ""
"The download failed:\n"
"\n"
"{error}"
msgstr ""
"La descarga falló:\n"
"\n"
"{error}"

#: polyhost/host.py:3856
#, python-brace-format
msgid ""
"The installer could not be started:\n"
"\n"
"{error}\n"
"\n"
"It was saved to:\n"
"{path}"
msgstr ""
"No se pudo iniciar el instalador:\n"
"\n"
"{error}\n"
"\n"
"Se guardó en:\n"
"{path}"

#: polyhost/host.py:3864
msgid "The WinCompose installer has started. Once it finishes and WinCompose is running, PolyKybd will switch to it automatically."
msgstr "El instalador de WinCompose se ha iniciado. Cuando termine y WinCompose esté en ejecución, PolyKybd cambiará a él automáticamente."

