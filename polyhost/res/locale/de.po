#: polyhost/device/command_ids.py:148
#, python-brace-format
msgid "preset {value}"
msgstr "Voreinstellung {value}"

#: polyhost/device/command_ids.py:150
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} min"

#: polyhost/device/command_ids.py:151
#, python-brace-format
msgid "{seconds} sec"
msgstr "{seconds} s"

#: polyhost/device/hid_fw_up.py:43
#, python-brace-format
msgid "File is too small ({size} bytes) to be a valid RP2040 firmware image (expected at least 264 bytes for boot2 + ARM vector table)."
msgstr "Die Datei ist zu klein ({size} Bytes) für ein gültiges RP2040-Firmware-Image (erwartet werden mindestens 264 Bytes für boot2 + ARM-Vektortabelle)."

#: polyhost/device/hid_fw_up.py:46
#, python-brace-format
msgid "Invalid RP2040 boot2 CRC32 (file has {stored}, computed {computed}). This does not appear to be a valid RP2040 QMK firmware .bin. Make sure you select the .bin produced by 'qmk compile', not a .uf2, .hex, or other format."
msgstr "Ungültige RP2040-boot2-CRC32 (Datei enthält {stored}, berechnet {computed}). Dies scheint keine gültige RP2040-QMK-Firmware-.bin zu sein. Die von 'qmk compile' erzeugte .bin auswählen, keine .uf2, .hex oder ein anderes Format."

#: polyhost/device/hid_fw_up.py:51
#, python-brace-format
msgid "Invalid ARM vector table: initial SP {sp} is outside RP2040 SRAM ({sram}). This does not appear to be a valid RP2040 firmware binary."
msgstr "Ungültige ARM-Vektortabelle: Der initiale SP {sp} liegt außerhalb des RP2040-SRAM ({sram}). Dies scheint keine gültige RP2040-Firmware-Binärdatei zu sein."

#: polyhost/device/hid_fw_up.py:54
msgid "This firmware binary does not appear to be built for PolyKybd. No PolyKybd identifier string was found in the binary. Make sure you selected a firmware compiled for 'polykybd/split72' using 'qmk compile'."
msgstr "Diese Firmware-Binärdatei scheint nicht für PolyKybd erstellt worden zu sein. In der Binärdatei wurde keine PolyKybd-Kennung gefunden. Eine Firmware auswählen, die mit 'qmk compile' für 'polykybd/split72' kompiliert wurde."

#: polyhost/device/hid_fw_up.py:59
#, python-brace-format
msgid ""
"No signature file was found next to this image ({sig}).\n"
"\n"
"The keyboard will ask you to confirm it physically: every keycap goes dark except a big A (accept) on the left half and R (reject) on the right. That is expected for a firmware you built yourself.\n"
"\n"
"If you meant to flash a release, download its '.sig' file into the same folder as the '.bin' first."
msgstr ""
"Neben diesem Image wurde keine Signaturdatei gefunden ({sig}).\n"
"\n"
"Die Tastatur fordert eine physische Bestätigung an: Alle Tasten werden dunkel, bis auf ein großes A (annehmen) auf der linken Hälfte und R (ablehnen) auf der rechten. Das ist bei einer selbst erstellten Firmware zu erwarten.\n"
"\n"
"Soll ein Release geflasht werden, zuerst dessen '.sig'-Datei in denselben Ordner wie die '.bin' herunterladen."

#: polyhost/device/hid_fw_up.py:65
#, python-brace-format
msgid "Cannot read {sig}: {error}"
msgstr "{sig} kann nicht gelesen werden: {error}"

#: polyhost/device/hid_fw_up.py:67
#, python-brace-format
msgid "{sig} is {size} bytes, but a signature is exactly {expected}. It will be ignored and the keyboard will ask you to confirm the image physically."
msgstr "{sig} ist {size} Bytes groß, eine Signatur hat aber genau {expected}. Sie wird ignoriert, und die Tastatur fordert eine physische Bestätigung des Images an."

#: polyhost/device/hid_fw_up.py:69
msgid "Firmware file is empty."
msgstr "Die Firmware-Datei ist leer."

#: polyhost/device/hid_fw_up.py:70
#, python-brace-format
msgid "Firmware too large: {size} bytes (max {max_kb} KB)."
msgstr "Firmware zu groß: {size} Bytes (max. {max_kb} KB)."

#: polyhost/device/hid_fw_up.py:71
#, python-brace-format
msgid "Sending FW_UP_BEGIN — {kb} KB, CRC32 {crc}…"
msgstr "FW_UP_BEGIN wird gesendet – {kb} KB, CRC32 {crc}…"

#: polyhost/device/hid_fw_up.py:72
#, python-brace-format
msgid "{step} — {elapsed}s elapsed…"
msgstr "{step} – {elapsed} s vergangen…"

#: polyhost/device/hid_fw_up.py:73
msgid "Erasing staging area — keyboard will reconnect when done"
msgstr "Bereitstellungsbereich wird gelöscht – die Tastatur verbindet sich danach neu"

#: polyhost/device/hid_fw_up.py:74
msgid "Erasing staging area (both halves)"
msgstr "Bereitstellungsbereich wird gelöscht (beide Hälften)"

#: polyhost/device/hid_fw_up.py:75
msgid "FW_UP_BEGIN timed out"
msgstr "Zeitüberschreitung bei FW_UP_BEGIN"

#: polyhost/device/hid_fw_up.py:76
msgid "staging area"
msgstr "Bereitstellungsbereich"

#: polyhost/device/hid_fw_up.py:78
msgid "FW_UP_BEGIN timed out — keyboard did not finish erasing within 90 s.  Check the USB cable and try again."
msgstr "Zeitüberschreitung bei FW_UP_BEGIN – die Tastatur hat das Löschen nicht innerhalb von 90 s abgeschlossen.  USB-Kabel prüfen und erneut versuchen."

#: polyhost/device/hid_fw_up.py:81
msgid "FW_UP_BEGIN failed — keyboard did not reconnect within 30 s.  Check the USB cable and try again."
msgstr "FW_UP_BEGIN fehlgeschlagen – die Tastatur hat sich nicht innerhalb von 30 s neu verbunden.  USB-Kabel prüfen und erneut versuchen."

#: polyhost/device/hid_fw_up.py:84
msgid ""
"FW_UP_BEGIN failed — the slave half could not be prepared.\n"
"Ensure both keyboard halves are connected and powered on.\n"
"If the slave half has old firmware (without HID firmware update support), it must be\n"
"flashed manually via UF2 before HID firmware update will work."
msgstr ""
"FW_UP_BEGIN fehlgeschlagen – die Slave-Hälfte konnte nicht vorbereitet werden.\n"
"Sicherstellen, dass beide Tastaturhälften verbunden und eingeschaltet sind.\n"
"Hat die Slave-Hälfte eine alte Firmware (ohne Unterstützung für Firmware-Updates über HID), muss sie\n"
"manuell per UF2 geflasht werden, bevor das Firmware-Update über HID funktioniert."

#: polyhost/device/hid_fw_up.py:88
#, python-brace-format
msgid "Staging erased. Sending {chunks} chunks…"
msgstr "Bereitstellungsbereich gelöscht. {chunks} Blöcke werden gesendet…"

#: polyhost/device/hid_fw_up.py:89
msgid "Update cancelled by user."
msgstr "Update vom Benutzer abgebrochen."

#: polyhost/device/hid_fw_up.py:90
#, python-brace-format
msgid "Chunk {n}/{total} ({kb} KB sent)…"
msgstr "Block {n}/{total} ({kb} KB gesendet)…"

#: polyhost/device/hid_fw_up.py:92
#, python-brace-format
msgid "Keyboard halves resynced — rewinding to chunk {n}/{total} (offset {offset}, resync {resync})…"
msgstr "Tastaturhälften neu synchronisiert – zurück zu Block {n}/{total} (Offset {offset}, Resync {resync})…"

#: polyhost/device/hid_fw_up.py:94
msgid "keyboard rejected the chunk"
msgstr "die Tastatur hat den Block abgelehnt"

#: polyhost/device/hid_fw_up.py:95
msgid "no reply from the keyboard"
msgstr "keine Antwort von der Tastatur"

#: polyhost/device/hid_fw_up.py:97
#, python-brace-format
msgid ""
"FW_UP_CHUNK failed at offset {offset} after {attempts} attempts — {reason}.\n"
"Ensure both keyboard halves are connected and running the same firmware, then try again — the update resumes from scratch and is safe to repeat."
msgstr ""
"FW_UP_CHUNK bei Offset {offset} nach {attempts} Versuchen fehlgeschlagen – {reason}.\n"
"Sicherstellen, dass beide Tastaturhälften verbunden sind und dieselbe Firmware ausführen, dann erneut versuchen – das Update beginnt von vorn und kann gefahrlos wiederholt werden."

#: polyhost/device/hid_fw_up.py:100
#, python-brace-format
msgid "Chunk {n}/{total} — retry {attempt}/{max_attempts} (waiting {ms} ms)…"
msgstr "Block {n}/{total} – Wiederholung {attempt}/{max_attempts} (warte {ms} ms)…"

#: polyhost/device/hid_fw_up.py:101
#, python-brace-format
msgid "Sending over the fast link: {kb} KB of {total_kb} KB…"
msgstr "Senden über die schnelle Verbindung: {kb} KB von {total_kb} KB…"

#: polyhost/device/hid_fw_up.py:102
#, python-brace-format
msgid "Fast link stopped ({reason}); continuing over HID from {kb} KB."
msgstr "Schnelle Verbindung abgebrochen ({reason}); es geht per HID ab {kb} KB weiter."

#: polyhost/device/hid_fw_up.py:106
msgid "port not openable"
msgstr "Port nicht öffenbar"

#: polyhost/device/hid_fw_up.py:107
msgid "pipe protocol too old"
msgstr "Pipe-Protokoll zu alt"

#: polyhost/device/hid_fw_up.py:108
msgid "port error"
msgstr "Portfehler"

#: polyhost/device/hid_fw_up.py:109
#, python-brace-format
msgid "Could not read {sig}: {error} — flashing unsigned."
msgstr "{sig} konnte nicht gelesen werden: {error} – es wird unsigniert geflasht."

#: polyhost/device/hid_fw_up.py:110
msgid "Sending image signature…"
msgstr "Image-Signatur wird gesendet…"

#: polyhost/device/hid_fw_up.py:111
#, python-brace-format
msgid "Ignoring {sig} — expected {expected} bytes, got {size}."
msgstr "{sig} wird ignoriert – erwartet {expected} Bytes, erhalten {size}."

#: polyhost/device/hid_fw_up.py:112
msgid "Verifying the staged image (CRC32)…"
msgstr "Bereitgestelltes Image wird geprüft (CRC32)…"

#: polyhost/device/hid_fw_up.py:114
msgid "This firmware is not signed. Confirm on the KEYBOARD: press the highlighted A (accept) or R (reject) key."
msgstr "Diese Firmware ist nicht signiert. Auf der TASTATUR bestätigen: die hervorgehobene Taste A (annehmen) oder R (ablehnen) drücken."

#: polyhost/device/hid_fw_up.py:117
msgid ""
"Timed out waiting for confirmation on the keyboard.\n"
"\n"
"The keyboard asks for a physical ACCEPT/REJECT because this image is not validly signed. Start the flash again and press the highlighted A key on the left half within a minute."
msgstr ""
"Zeitüberschreitung beim Warten auf die Bestätigung an der Tastatur.\n"
"\n"
"Die Tastatur verlangt ein physisches ACCEPT/REJECT, weil dieses Image nicht gültig signiert ist. Das Flashen erneut starten und innerhalb einer Minute die hervorgehobene Taste A auf der linken Hälfte drücken."

#: polyhost/device/hid_fw_up.py:122
#, python-brace-format
msgid ""
"The keyboard refused this firmware: the signature does not match the image.\n"
"\n"
"{sig} is not a valid signature for this .bin. Either the two files come from different builds, or one of them is damaged — re-download both from the same release.\n"
"\n"
"There is deliberately no way to confirm past this on the keyboard: a signature that fails to verify means the file is not what it claims to be."
msgstr ""
"Die Tastatur hat diese Firmware abgelehnt: Die Signatur passt nicht zum Image.\n"
"\n"
"{sig} ist keine gültige Signatur für diese .bin. Entweder stammen die beiden Dateien aus verschiedenen Builds, oder eine davon ist beschädigt – beide erneut aus demselben Release herunterladen.\n"
"\n"
"Es gibt bewusst keine Möglichkeit, dies auf der Tastatur zu übergehen: Eine Signatur, die sich nicht verifizieren lässt, bedeutet, dass die Datei nicht das ist, was sie vorgibt zu sein."

#: polyhost/device/hid_fw_up.py:131
msgid ""
"The keyboard refused this firmware: it is not signed.\n"
"\n"
"Released firmware ships a matching '.sig' file — download it next to the .bin and flash again.\n"
"\n"
"To flash a build you compiled yourself, flash again and press the highlighted A (accept) key on the keyboard when it asks."
msgstr ""
"Die Tastatur hat diese Firmware abgelehnt: Sie ist nicht signiert.\n"
"\n"
"Veröffentlichte Firmware wird mit einer passenden „.sig“-Datei ausgeliefert – diese neben die .bin-Datei herunterladen und erneut flashen.\n"
"\n"
"Um einen selbst kompilierten Build zu flashen, erneut flashen und die hervorgehobene Taste A (annehmen) auf der Tastatur drücken, wenn sie danach fragt."

#: polyhost/device/hid_fw_up.py:136
msgid "FW_UP_COMMIT failed — CRC mismatch on keyboard. Try again."
msgstr "FW_UP_COMMIT fehlgeschlagen – CRC-Abweichung auf der Tastatur. Erneut versuchen."

#: polyhost/device/hid_fw_up.py:137
msgid "Done. New firmware staged and verified on the keyboard."
msgstr "Fertig. Neue Firmware auf der Tastatur bereitgestellt und geprüft."

#: polyhost/device/hid_fw_up.py:139
msgid ""
"Firmware staged and verified successfully.\n"
"\n"
"The new image is stored and CRC-checked on the keyboard, but it is not active yet — the keyboard is still running its current firmware. Activating the staged image will be a separate step."
msgstr ""
"Firmware erfolgreich bereitgestellt und geprüft.\n"
"\n"
"Das neue Image ist auf der Tastatur gespeichert und per CRC geprüft, aber noch nicht aktiv – die Tastatur führt weiterhin ihre aktuelle Firmware aus. Das Aktivieren des bereitgestellten Images ist ein separater Schritt."

#: polyhost/device/hid_fw_up.py:143
msgid "Sending FW_UP_APPLY…"
msgstr "FW_UP_APPLY wird gesendet…"

#: polyhost/device/hid_fw_up.py:145
msgid ""
"Apply is not available.\n"
"\n"
"The keyboard reported no valid staged image, or this firmware was built without in-app apply (FW_UP_INAPP_APPLY=no). The staged image is unchanged."
msgstr ""
"Anwenden ist nicht verfügbar.\n"
"\n"
"Die Tastatur hat kein gültiges bereitgestelltes Image gemeldet, oder diese Firmware wurde ohne In-App-Anwenden erstellt (FW_UP_INAPP_APPLY=no). Das bereitgestellte Image bleibt unverändert."

#: polyhost/device/hid_fw_up.py:149
msgid "Applying — keyboard is erasing its flash and rebooting…"
msgstr "Wird angewendet – die Tastatur löscht ihren Flash-Speicher und startet neu…"

#: polyhost/device/hid_fw_up.py:151
msgid ""
"Keyboard did not reconnect within 30 s after apply.\n"
"If it does not come back on its own, hold BOOTSEL on the master half and re-flash the .uf2."
msgstr ""
"Die Tastatur hat sich nach dem Anwenden nicht innerhalb von 30 s neu verbunden.\n"
"Kommt sie nicht von selbst zurück, BOOTSEL auf der Master-Hälfte gedrückt halten und die .uf2 erneut flashen."

#: polyhost/device/hid_fw_up.py:155
msgid ""
"The keyboard acknowledged APPLY but did not reboot within 10 s.\n"
"The staged image was not applied; the keyboard still runs its current firmware. Try the apply again."
msgstr ""
"Die Tastatur hat APPLY bestätigt, ist aber innerhalb von 10 s nicht neu gestartet.\n"
"Das bereitgestellte Image wurde nicht angewendet; die Tastatur führt weiterhin ihre aktuelle Firmware aus. Das Anwenden erneut versuchen."

#: polyhost/device/hid_fw_up.py:158
msgid "Done. Keyboard reconnected on the applied firmware."
msgstr "Fertig. Die Tastatur hat sich mit der angewendeten Firmware neu verbunden."

#: polyhost/device/hid_fw_up.py:160
msgid ""
"Firmware applied — the keyboard rebooted and reconnected.\n"
"\n"
"Both halves now run the new firmware."
msgstr ""
"Firmware angewendet – die Tastatur wurde neu gestartet und hat sich neu verbunden.\n"
"\n"
"Beide Hälften laufen jetzt mit der neuen Firmware."

#: polyhost/device/split_link.py:30
#, python-brace-format
msgid "{prefix} — the USB half answered, but the other keyboard half did not confirm that it had erased the {what} within 90 s. Check the cable between the two halves. If the other half stays dark, it is not running firmware and needs the firmware .uf2 copied onto it by hand."
msgstr "{prefix} – die USB-Hälfte hat geantwortet, aber die andere Tastaturhälfte hat nicht innerhalb von 90 s bestätigt, dass sie den {what} gelöscht hat. Das Kabel zwischen den beiden Hälften prüfen. Bleibt die andere Hälfte dunkel, läuft darauf keine Firmware, und die Firmware-.uf2 muss manuell auf sie kopiert werden."

