#: polyhost/forwarder.py:967
msgid "forwarder"
msgstr "转发器"

#: polyhost/forwarder.py:969
msgid "Forwarder mode: this machine has no keyboard. It watches the active window here and relays it to the PolyKybdHost running on the machine the keyboard is plugged into."
msgstr "转发器模式：本机没有连接键盘。它会监视本机的活动窗口，并将其转发给运行在连接键盘的电脑上的 PolyKybdHost。"

#: polyhost/forwarder.py:1009
msgid "Download, install, and restart the forwarder now?"
msgstr "立即下载、安装并重新启动转发器吗？"

#: polyhost/gui/about_dialog.py:43
msgid "Blog"
msgstr "博客"

#: polyhost/gui/about_dialog.py:76
#, python-brace-format
msgid "Version {version}"
msgstr "版本 {version}"

#: polyhost/gui/about_dialog.py:107
msgid "About PolyKybdHost"
msgstr "关于 PolyKybdHost"

#: polyhost/gui/about_dialog.py:151 polyhost/gui/about_dialog.py:162
msgid "Copy diagnostics"
msgstr "复制诊断信息"

#: polyhost/gui/about_dialog.py:156
msgid "Copied ✓"
msgstr "已复制 ✓"

#: polyhost/gui/agent_hooks.py:23 polyhost/gui/agent_hooks.py:35
msgid "Set Up Hooks"
msgstr "设置钩子"

#: polyhost/gui/agent_hooks.py:44
msgid "The hooks are already set up."
msgstr "钩子已经设置好了。"

#: polyhost/gui/agent_hooks.py:47
#, python-brace-format
msgid "Write the PolyKybd hooks into {files}? Your own hooks are kept, and a copy of each file is saved as <file>.polykybd.bak."
msgstr "将 PolyKybd 钩子写入 {files} 吗？您自己的钩子会保留，并且每个文件的副本会保存为 <file>.polykybd.bak。"

#: polyhost/gui/boot_loop_dialog.py:26
msgid "Reboots the keyboard again and again to catch an intermittent boot hang. After each reboot it waits for the keyboard to come back and reads its crash record. It stops at the first boot that left a fresh crash record, at a boot that does not come back within a minute, or after the last round.<br><br>The keyboard does not type while this runs, and each round takes a few seconds."
msgstr "反复重启键盘，以捕捉偶发的启动卡死。每次重启后，它会等待键盘恢复并读取其崩溃记录。遇到第一次留下新崩溃记录的启动、一分钟内未恢复的启动，或完成最后一轮后，测试即停止。<br><br>测试运行期间键盘无法输入，每轮需要几秒钟。"

