msgstr "Blog"

#: polyhost/gui/about_dialog.py:97
msgid "About PolyKybdHost"
msgstr "Giới thiệu PolyKybdHost"

#: polyhost/gui/about_dialog.py:141 polyhost/gui/about_dialog.py:151
