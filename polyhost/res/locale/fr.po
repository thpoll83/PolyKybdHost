msgstr "Configuré pour une autre copie de l'application : {path}"

#: polyhost/gui/shell_title_dialog.py:52 polyhost/gui/shell_title_dialog.py:89
msgid "Not found"
msgstr "Introuvable"

#: polyhost/gui/shell_title_dialog.py:54
#, python-brace-format
