#: polyhost/device/command_ids.py:167
#, python-brace-format
msgid "preset {value}"
msgstr "préréglage {value}"

#: polyhost/device/command_ids.py:169
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} min"

#: polyhost/device/command_ids.py:170
#, python-brace-format
msgid "{seconds} sec"
msgstr "{seconds} s"

#: polyhost/device/hid_fw_up.py:43
#, python-brace-format
msgid "File is too small ({size} bytes) to be a valid RP2040 firmware image (expected at least 264 bytes for boot2 + ARM vector table)."
msgstr "Le fichier est trop petit ({size} octets) pour être une image de firmware RP2040 valide (au moins 264 octets attendus pour boot2 + la table des vecteurs ARM)."

#: polyhost/device/hid_fw_up.py:46
#, python-brace-format
msgid "Invalid RP2040 boot2 CRC32 (file has {stored}, computed {computed}). This does not appear to be a valid RP2040 QMK firmware .bin. Make sure you select the .bin produced by 'qmk compile', not a .uf2, .hex, or other format."
msgstr "CRC32 boot2 RP2040 invalide (le fichier contient {stored}, calculé {computed}). Ce fichier ne semble pas être un .bin de firmware QMK RP2040 valide. Veillez à sélectionner le .bin produit par 'qmk compile', et non un .uf2, un .hex ou un autre format."

#: polyhost/device/hid_fw_up.py:51
#, python-brace-format
msgid "Invalid ARM vector table: initial SP {sp} is outside RP2040 SRAM ({sram}). This does not appear to be a valid RP2040 firmware binary."
msgstr "Table des vecteurs ARM invalide : le SP initial {sp} est hors de la SRAM du RP2040 ({sram}). Ce fichier ne semble pas être un binaire de firmware RP2040 valide."

#: polyhost/device/hid_fw_up.py:54
msgid "This firmware binary does not appear to be built for PolyKybd. No PolyKybd identifier string was found in the binary. Make sure you selected a firmware compiled for 'polykybd/split72' using 'qmk compile'."
msgstr "Ce binaire de firmware ne semble pas avoir été compilé pour PolyKybd. Aucune chaîne d'identification PolyKybd n'a été trouvée dans le binaire. Veillez à sélectionner un firmware compilé pour 'polykybd/split72' avec 'qmk compile'."

#: polyhost/device/hid_fw_up.py:59
#, python-brace-format
msgid ""
"No signature file was found next to this image ({sig}).\n"
"\n"
"The keyboard will ask you to confirm it physically: every keycap goes dark except a big A (accept) on the left half and R (reject) on the right. That is expected for a firmware you built yourself.\n"
"\n"
"If you meant to flash a release, download its '.sig' file into the same folder as the '.bin' first."
msgstr ""
"Aucun fichier de signature n'a été trouvé à côté de cette image ({sig}).\n"
"\n"
"Le clavier vous demandera de confirmer physiquement : toutes les touches s'éteignent sauf un grand A (accepter) sur la moitié gauche et R (refuser) sur la droite. C'est normal pour un firmware que vous avez compilé vous-même.\n"
"\n"
"Si vous vouliez flasher une version publiée, téléchargez d'abord son fichier '.sig' dans le même dossier que le '.bin'."

#: polyhost/device/hid_fw_up.py:65
#, python-brace-format
msgid "Cannot read {sig}: {error}"
msgstr "Impossible de lire {sig} : {error}"

#: polyhost/device/hid_fw_up.py:67
#, python-brace-format
msgid "{sig} is {size} bytes, but a signature is exactly {expected}. It will be ignored and the keyboard will ask you to confirm the image physically."
msgstr "{sig} fait {size} octets, mais une signature fait exactement {expected}. Il sera ignoré et le clavier vous demandera de confirmer l'image physiquement."

#: polyhost/device/hid_fw_up.py:69
msgid "Firmware file is empty."
msgstr "Le fichier de firmware est vide."

#: polyhost/device/hid_fw_up.py:70
#, python-brace-format
msgid "Firmware too large: {size} bytes (max {max_kb} KB)."
msgstr "Firmware trop volumineux : {size} octets (max. {max_kb} KB)."

#: polyhost/device/hid_fw_up.py:71
#, python-brace-format
msgid "Sending FW_UP_BEGIN — {kb} KB, CRC32 {crc}…"
msgstr "Envoi de FW_UP_BEGIN — {kb} KB, CRC32 {crc}…"

#: polyhost/device/hid_fw_up.py:72
#, python-brace-format
msgid "{step} — {elapsed}s elapsed…"
msgstr "{step} — {elapsed} s écoulées…"

#: polyhost/device/hid_fw_up.py:73
msgid "Erasing staging area — keyboard will reconnect when done"
msgstr "Effacement de la zone de préparation — le clavier se reconnectera ensuite"

#: polyhost/device/hid_fw_up.py:74
msgid "Erasing staging area (both halves)"
msgstr "Effacement de la zone de préparation (les deux moitiés)"

#: polyhost/device/hid_fw_up.py:75
msgid "FW_UP_BEGIN timed out"
msgstr "Délai dépassé pour FW_UP_BEGIN"

#: polyhost/device/hid_fw_up.py:76
msgid "staging area"
msgstr "zone de préparation"

#: polyhost/device/hid_fw_up.py:78
msgid "FW_UP_BEGIN timed out — keyboard did not finish erasing within 90 s.  Check the USB cable and try again."
msgstr "Délai dépassé pour FW_UP_BEGIN — le clavier n'a pas terminé l'effacement en 90 s.  Vérifiez le câble USB et réessayez."

#: polyhost/device/hid_fw_up.py:81
msgid "FW_UP_BEGIN failed — keyboard did not reconnect within 30 s.  Check the USB cable and try again."
msgstr "Échec de FW_UP_BEGIN — le clavier ne s'est pas reconnecté en 30 s.  Vérifiez le câble USB et réessayez."

#: polyhost/device/hid_fw_up.py:84
msgid ""
"FW_UP_BEGIN failed — the slave half could not be prepared.\n"
"Ensure both keyboard halves are connected and powered on.\n"
"If the slave half has old firmware (without HID firmware update support), it must be\n"
"flashed manually via UF2 before HID firmware update will work."
msgstr ""
"Échec de FW_UP_BEGIN — la moitié esclave n'a pas pu être préparée.\n"
"Vérifiez que les deux moitiés du clavier sont connectées et sous tension.\n"
"Si la moitié esclave a un ancien firmware (sans prise en charge de la mise à jour du firmware par HID), elle doit être\n"
"flashée manuellement par UF2 avant que la mise à jour du firmware par HID fonctionne."

#: polyhost/device/hid_fw_up.py:88
#, python-brace-format
msgid "Staging erased. Sending {chunks} chunks…"
msgstr "Zone de préparation effacée. Envoi de {chunks} blocs…"

#: polyhost/device/hid_fw_up.py:89
msgid "Update cancelled by user."
msgstr "Mise à jour annulée par l'utilisateur."

#: polyhost/device/hid_fw_up.py:90
#, python-brace-format
msgid "Chunk {n}/{total} ({kb} KB sent)…"
msgstr "Bloc {n}/{total} ({kb} KB envoyés)…"

#: polyhost/device/hid_fw_up.py:92
#, python-brace-format
msgid "Keyboard halves resynced — rewinding to chunk {n}/{total} (offset {offset}, resync {resync})…"
msgstr "Moitiés du clavier resynchronisées — retour au bloc {n}/{total} (décalage {offset}, resync {resync})…"

#: polyhost/device/hid_fw_up.py:94
msgid "keyboard rejected the chunk"
msgstr "le clavier a refusé le bloc"

#: polyhost/device/hid_fw_up.py:95
msgid "no reply from the keyboard"
msgstr "aucune réponse du clavier"

#: polyhost/device/hid_fw_up.py:97
#, python-brace-format
msgid ""
"FW_UP_CHUNK failed at offset {offset} after {attempts} attempts — {reason}.\n"
"Ensure both keyboard halves are connected and running the same firmware, then try again — the update resumes from scratch and is safe to repeat."
msgstr ""
"Échec de FW_UP_CHUNK au décalage {offset} après {attempts} tentatives — {reason}.\n"
"Vérifiez que les deux moitiés du clavier sont connectées et exécutent le même firmware, puis réessayez — la mise à jour reprend depuis le début et peut être répétée sans risque."

#: polyhost/device/hid_fw_up.py:100
#, python-brace-format
msgid "Chunk {n}/{total} — retry {attempt}/{max_attempts} (waiting {ms} ms)…"
msgstr "Bloc {n}/{total} — nouvelle tentative {attempt}/{max_attempts} (attente de {ms} ms)…"

#: polyhost/device/hid_fw_up.py:101
#, python-brace-format
msgid "Sending over the fast link: {kb} KB of {total_kb} KB…"
msgstr "Envoi par la liaison rapide : {kb} KB sur {total_kb} KB…"

#: polyhost/device/hid_fw_up.py:102
#, python-brace-format
msgid "Fast link stopped ({reason}); continuing over HID from {kb} KB."
msgstr "Liaison rapide interrompue ({reason}) ; poursuite par HID à partir de {kb} KB."

#: polyhost/device/hid_fw_up.py:106
msgid "port not openable"
msgstr "port impossible à ouvrir"

#: polyhost/device/hid_fw_up.py:107
msgid "pipe protocol too old"
msgstr "protocole du canal trop ancien"

#: polyhost/device/hid_fw_up.py:108
msgid "port error"
msgstr "erreur de port"

#: polyhost/device/hid_fw_up.py:109
#, python-brace-format
msgid "Could not read {sig}: {error} — flashing unsigned."
msgstr "Impossible de lire {sig} : {error} — flashage sans signature."

#: polyhost/device/hid_fw_up.py:110
msgid "Sending image signature…"
msgstr "Envoi de la signature de l'image…"

#: polyhost/device/hid_fw_up.py:111
#, python-brace-format
msgid "Ignoring {sig} — expected {expected} bytes, got {size}."
msgstr "{sig} ignoré — {expected} octets attendus, {size} reçus."

#: polyhost/device/hid_fw_up.py:112
msgid "Verifying the staged image (CRC32)…"
msgstr "Vérification de l'image préparée (CRC32)…"

#: polyhost/device/hid_fw_up.py:114
msgid "This firmware is not signed. Confirm on the KEYBOARD: press the highlighted A (accept) or R (reject) key."
msgstr "Ce firmware n'est pas signé. Confirmez sur le CLAVIER : appuyez sur la touche A (accepter) ou R (refuser) mise en évidence."

#: polyhost/device/hid_fw_up.py:117
msgid ""
"Timed out waiting for confirmation on the keyboard.\n"
"\n"
"The keyboard asks for a physical ACCEPT/REJECT because this image is not validly signed. Start the flash again and press the highlighted A key on the left half within a minute."
msgstr ""
"Délai dépassé en attendant la confirmation sur le clavier.\n"
"\n"
"Le clavier demande une ACCEPTATION/un REFUS physique car cette image n'est pas signée de façon valide. Relancez le flashage et appuyez sur la touche A mise en évidence sur la moitié gauche dans la minute."

#: polyhost/device/hid_fw_up.py:122
#, python-brace-format
msgid ""
"The keyboard refused this firmware: the signature does not match the image.\n"
"\n"
"{sig} is not a valid signature for this .bin. Either the two files come from different builds, or one of them is damaged — re-download both from the same release.\n"
"\n"
"There is deliberately no way to confirm past this on the keyboard: a signature that fails to verify means the file is not what it claims to be."
msgstr ""
"Le clavier a refusé ce firmware : la signature ne correspond pas à l'image.\n"
"\n"
"{sig} n'est pas une signature valide pour ce .bin. Soit les deux fichiers proviennent de compilations différentes, soit l'un d'eux est endommagé — retéléchargez-les tous les deux depuis la même version.\n"
"\n"
"Il n'existe volontairement aucun moyen de passer outre sur le clavier : une signature qui ne se vérifie pas signifie que le fichier n'est pas ce qu'il prétend être."

#: polyhost/device/hid_fw_up.py:131
msgid ""
"The keyboard refused this firmware: it is not signed.\n"
"\n"
"Released firmware ships a matching '.sig' file — download it next to the .bin and flash again.\n"
"\n"
"To flash a build you compiled yourself, flash again and press the highlighted A (accept) key on the keyboard when it asks."
msgstr ""
"Le clavier a refusé ce firmware : il n'est pas signé.\n"
"\n"
"Le firmware publié est fourni avec un fichier « .sig » correspondant — téléchargez-le à côté du .bin et flashez de nouveau.\n"
"\n"
"Pour flasher une version que vous avez compilée vous-même, flashez de nouveau et appuyez sur la touche A (accepter) mise en évidence sur le clavier lorsqu'il le demande."

#: polyhost/device/hid_fw_up.py:136
msgid "FW_UP_COMMIT failed — CRC mismatch on keyboard. Try again."
msgstr "Échec de FW_UP_COMMIT — CRC différent sur le clavier. Réessayez."

#: polyhost/device/hid_fw_up.py:137
msgid "Done. New firmware staged and verified on the keyboard."
msgstr "Terminé. Nouveau firmware préparé et vérifié sur le clavier."

#: polyhost/device/hid_fw_up.py:139
msgid ""
"Firmware staged and verified successfully.\n"
"\n"
"The new image is stored and CRC-checked on the keyboard, but it is not active yet — the keyboard is still running its current firmware. Activating the staged image will be a separate step."
msgstr ""
"Firmware préparé et vérifié avec succès.\n"
"\n"
"La nouvelle image est stockée et vérifiée par CRC sur le clavier, mais elle n'est pas encore active — le clavier exécute toujours son firmware actuel. L'activation de l'image préparée sera une étape distincte."

#: polyhost/device/hid_fw_up.py:143
msgid "Sending FW_UP_APPLY…"
msgstr "Envoi de FW_UP_APPLY…"

#: polyhost/device/hid_fw_up.py:145
msgid ""
"Apply is not available.\n"
"\n"
"The keyboard reported no valid staged image, or this firmware was built without in-app apply (FW_UP_INAPP_APPLY=no). The staged image is unchanged."
msgstr ""
"L'application n'est pas disponible.\n"
"\n"
"Le clavier n'a signalé aucune image préparée valide, ou ce firmware a été compilé sans application intégrée (FW_UP_INAPP_APPLY=no). L'image préparée est inchangée."

#: polyhost/device/hid_fw_up.py:149
msgid "Applying — keyboard is erasing its flash and rebooting…"
msgstr "Application — le clavier efface sa mémoire flash et redémarre…"

#: polyhost/device/hid_fw_up.py:151
msgid ""
"Keyboard did not reconnect within 30 s after apply.\n"
"If it does not come back on its own, hold BOOTSEL on the master half and re-flash the .uf2."
msgstr ""
"Le clavier ne s'est pas reconnecté dans les 30 s suivant l'application.\n"
"S'il ne revient pas de lui-même, maintenez BOOTSEL sur la moitié maître et reflashez le .uf2."

#: polyhost/device/hid_fw_up.py:155
msgid ""
"The keyboard acknowledged APPLY but did not reboot within 10 s.\n"
"The staged image was not applied; the keyboard still runs its current firmware. Try the apply again."
msgstr ""
"Le clavier a acquitté APPLY mais n'a pas redémarré dans les 10 s.\n"
"L'image préparée n'a pas été appliquée ; le clavier exécute toujours son firmware actuel. Réessayez l'application."

#: polyhost/device/hid_fw_up.py:158
msgid "Done. Keyboard reconnected on the applied firmware."
msgstr "Terminé. Le clavier s'est reconnecté avec le firmware appliqué."

#: polyhost/device/hid_fw_up.py:160
msgid ""
"Firmware applied — the keyboard rebooted and reconnected.\n"
"\n"
"Both halves now run the new firmware."
msgstr ""
"Firmware appliqué — le clavier a redémarré et s'est reconnecté.\n"
"\n"
"Les deux moitiés exécutent désormais le nouveau firmware."

#: polyhost/device/split_link.py:30
#, python-brace-format
msgid "{prefix} — the USB half answered, but the other keyboard half did not confirm that it had erased the {what} within 90 s. Check the cable between the two halves. If the other half stays dark, it is not running firmware and needs the firmware .uf2 copied onto it by hand."
msgstr "{prefix} — la moitié USB a répondu, mais l'autre moitié du clavier n'a pas confirmé avoir effacé la {what} dans les 90 s. Vérifiez le câble entre les deux moitiés. Si l'autre moitié reste éteinte, elle n'exécute aucun firmware et le fichier .uf2 du firmware doit y être copié manuellement."

