msgstr "Klasörde göster"

#: polyhost/gui/split_link_dialog.py:93
msgid "Open guide"
msgstr "Kılavuzu aç"

#: polyhost/gui/split_link_dialog.py:115
msgid "Looking up the newest firmware release…"
msgstr "En yeni ürün yazılımı sürümü aranıyor…"

#: polyhost/gui/split_link_dialog.py:132
#, python-brace-format
msgid "Saved: {path}"
msgstr "Kaydedildi: {path}"

#: polyhost/gui/split_link_dialog.py:134
