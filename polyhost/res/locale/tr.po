#: polyhost/forwarder.py:556
msgid "The hooks are written, but this forwarder runs without --report-rpc, so it cannot pass agent reports on. Start it with --report-rpc to show this computer's agents on the keys."
msgstr "Kancalar yazıldı, ancak bu yönlendirici --report-rpc olmadan çalışıyor, bu yüzden ajan bildirimlerini iletemez. Bu bilgisayarın ajanlarını tuşlarda göstermek için yönlendiriciyi --report-rpc ile başlatın."

#: polyhost/forwarder.py:559
msgid "The hooks are written. On the keyboard computer, turn on Settings > AI agents > \"Agents from other computers\"."
msgstr "Kancalar yazıldı. Klavye bilgisayarında Ayarlar > Yapay zekâ ajanları > \"Diğer bilgisayarlardaki ajanlar\" seçeneğini açın."

#: polyhost/forwarder.py:890
msgid "PolyForwarder settings"
msgstr "PolyForwarder ayarları"

#: polyhost/forwarder.py:891
msgid "The settings could not be saved to the settings file, so they will not take effect. Another program may be holding it open. Try again, or see the log."
msgstr "Ayarlar ayar dosyasına kaydedilemedi, bu yüzden etkili olmayacaklar. Dosya başka bir program tarafından açık tutuluyor olabilir. Yeniden deneyin veya günlüğe bakın."

#: polyhost/forwarder.py:909
msgid "Paired. The forwarder uses the authenticated connection from its next start. Restart it now?"
msgstr "Eşleştirildi. Yönlendirici, kimliği doğrulanmış bağlantıyı bir sonraki başlatılışından itibaren kullanır. Şimdi yeniden başlatılsın mı?"

#: polyhost/forwarder.py:924
#, python-brace-format
msgid "authenticated RPC (port {port})"
msgstr "kimliği doğrulanmış RPC (bağlantı noktası {port})"

#: polyhost/forwarder.py:926
msgid "legacy plaintext TCP relay"
msgstr "eski düz metin TCP aktarımı"

#: polyhost/forwarder.py:929
msgid "reaching the keyboard machine"
msgstr "klavye bilgisayarına ulaşılıyor"

#: polyhost/forwarder.py:930
