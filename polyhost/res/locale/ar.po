#: polyhost/host.py:3341
msgid "PolyKybd Firmware Update"
msgstr "تحديث البرنامج الثابت لـ PolyKybd"

#: polyhost/host.py:3342
#, python-brace-format
msgid "New firmware v{version} is available. Click the tray icon to update."
msgstr "يتوفر برنامج ثابت جديد v{version}. انقر على أيقونة علبة النظام للتحديث."

#: polyhost/host.py:3359 polyhost/host.py:3400
msgid "The keyboard must be connected to update the firmware."
msgstr "يجب توصيل لوحة المفاتيح لتحديث البرنامج الثابت."

#: polyhost/host.py:3365
msgid "Checking for firmware update…"
msgstr "جارٍ التحقق من وجود تحديث للبرنامج الثابت…"

#: polyhost/host.py:3379 polyhost/host.py:3389 polyhost/host.py:3392
msgid "PolyKybd Firmware"
msgstr "البرنامج الثابت لـ PolyKybd"

#: polyhost/host.py:3380
#, python-brace-format
msgid ""
"Firmware v{version} has been released, but it does not include a downloadable firmware file, so it cannot be installed yet.\n"
"\n"
"Your keyboard is on v{current}. This usually means the release build failed — the release page will get its firmware once that is fixed."
msgstr ""
"صدر البرنامج الثابت v{version}، لكنه لا يتضمن ملف برنامج ثابت قابلًا للتنزيل، لذا لا يمكن تثبيته بعد.\n"
"\n"
"لوحة مفاتيحك على الإصدار v{current}. يعني هذا عادةً أن بناء الإصدار فشل — وستحصل صفحة الإصدار على برنامجها الثابت بمجرد إصلاح ذلك."

#: polyhost/host.py:3390
msgid "No firmware release could be found."
msgstr "تعذّر العثور على إصدار للبرنامج الثابت."

#: polyhost/host.py:3393
#, python-brace-format
msgid "You are running the latest firmware (v{version})."
msgstr "أنت تستخدم أحدث برنامج ثابت (v{version})."

