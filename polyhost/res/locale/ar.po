msgstr "المثبّت: غير معروف (لم تُبلغ لوحة المفاتيح عن إصدارها)"

#: polyhost/host.py:3407
#, python-brace-format
msgid "Firmware {version} is available."
msgstr "يتوفر البرنامج الثابت {version}."

#: polyhost/host.py:3409
msgid "Both halves update over HID and reboot automatically."
msgstr "يتم تحديث كلا النصفين عبر HID ويُعاد تشغيلهما تلقائيًا."

