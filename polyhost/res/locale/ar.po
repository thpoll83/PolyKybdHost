msgstr "لم يتم تكوين مضيف"

#: polyhost/forwarder.py:344
#, python-brace-format
msgid "PolyKybdHost {version} (forwarder) → {target}"
msgstr "PolyKybdHost {version} (مُعيد التوجيه) ← {target}"

#: polyhost/forwarder.py:349
msgid "Forwarding paused"
msgstr "إعادة التوجيه متوقفة مؤقتًا"

#: polyhost/forwarder.py:352
#, python-brace-format
msgid "Forwarding to {target}…"
msgstr "جارٍ إعادة التوجيه إلى {target}…"

#: polyhost/forwarder.py:354
#, python-brace-format
msgid "Forwarding to {target}"
msgstr "إعادة التوجيه إلى {target}"

#: polyhost/forwarder.py:355
#, python-brace-format
msgid "Cannot reach {target}"
msgstr "تعذّر الوصول إلى {target}"

#: polyhost/forwarder.py:748
msgid "PolyForwarder settings"
msgstr "إعدادات PolyForwarder"

#: polyhost/forwarder.py:749
msgid "The settings could not be saved to the settings file, so they will not take effect. Another program may be holding it open. Try again, or see the log."
msgstr "تعذّر حفظ الإعدادات في ملف الإعدادات، لذا لن تسري. قد يكون برنامج آخر يُبقي الملف مفتوحًا. حاول مرة أخرى، أو راجع السجل."

#: polyhost/forwarder.py:768
#, python-brace-format
msgid "authenticated RPC (port {port})"
msgstr "RPC موثّق (المنفذ {port})"

#: polyhost/forwarder.py:770
msgid "legacy plaintext TCP relay"
msgstr "مُرحِّل TCP قديم بنص غير مشفّر"

#: polyhost/forwarder.py:773
msgid "reaching the keyboard machine"
msgstr "يصل إلى جهاز لوحة المفاتيح"

#: polyhost/forwarder.py:774
msgid "not reaching the keyboard machine"
msgstr "لا يصل إلى جهاز لوحة المفاتيح"

#: polyhost/forwarder.py:775
msgid "starting up"
msgstr "جارٍ البدء"

#: polyhost/forwarder.py:777
msgid "<b>Mode:</b> forwarder — no keyboard attached to this machine"
msgstr "<b>الوضع:</b> مُعيد التوجيه — لا توجد لوحة مفاتيح متصلة بهذا الجهاز"

#: polyhost/forwarder.py:778
#, python-brace-format
msgid "<b>Target:</b> {target}"
msgstr "<b>الهدف:</b> {target}"

#: polyhost/forwarder.py:780
#, python-brace-format
msgid "<b>Window reports:</b> {transport}"
msgstr "<b>تقارير النوافذ:</b> {transport}"

#: polyhost/forwarder.py:783
#, python-brace-format
msgid "<b>Host file:</b> {path}"
msgstr "<b>ملف المضيف:</b> {path}"

#: polyhost/forwarder.py:804
msgid "About PolyKybdHost (forwarder)"
msgstr "حول PolyKybdHost (مُعيد التوجيه)"

#: polyhost/forwarder.py:813
msgid "Forwarder mode: this machine has no keyboard. It watches the active window here and relays it to the PolyKybdHost running on the machine the keyboard is plugged into."
msgstr "وضع إعادة التوجيه: لا توجد لوحة مفاتيح على هذا الجهاز. يراقب النافذة النشطة هنا ويرسلها إلى PolyKybdHost الذي يعمل على الجهاز الموصولة به لوحة المفاتيح."

#: polyhost/forwarder.py:852
msgid "Download, install, and restart the forwarder now?"
msgstr "هل تريد تنزيل مُعيد التوجيه وتثبيته وإعادة تشغيله الآن؟"

#: polyhost/gui/about_dialog.py:40
msgid "Blog"
msgstr "المدوّنة"

#: polyhost/gui/about_dialog.py:97
msgid "About PolyKybdHost"
msgstr "حول PolyKybdHost"

#: polyhost/gui/about_dialog.py:141 polyhost/gui/about_dialog.py:151
msgid "Copy diagnostics"
msgstr "نسخ معلومات التشخيص"

#: polyhost/gui/about_dialog.py:145
msgid "Copied ✓"
