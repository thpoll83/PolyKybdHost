#: polyhost/device/command_ids.py:174
#, python-brace-format
msgid "preset {value}"
msgstr "الإعداد المسبق {value}"

#: polyhost/device/command_ids.py:176
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} دقيقة"

#: polyhost/device/command_ids.py:177
#, python-brace-format
msgid "{seconds} sec"
msgstr "{seconds} ثانية"

#: polyhost/device/hid_fw_up.py:43
#, python-brace-format
msgid "File is too small ({size} bytes) to be a valid RP2040 firmware image (expected at least 264 bytes for boot2 + ARM vector table)."
msgstr "الملف صغير جدًا ({size} بايت) ليكون صورة برنامج ثابت صالحة لـ RP2040 (المتوقع 264 بايت على الأقل لـ boot2 + جدول متجهات ARM)."

#: polyhost/device/hid_fw_up.py:46
#, python-brace-format
msgid "Invalid RP2040 boot2 CRC32 (file has {stored}, computed {computed}). This does not appear to be a valid RP2040 QMK firmware .bin. Make sure you select the .bin produced by 'qmk compile', not a .uf2, .hex, or other format."
msgstr "قيمة CRC32 لـ boot2 الخاص بـ RP2040 غير صالحة (في الملف {stored}، والمحسوبة {computed}). لا يبدو أن هذا ملف .bin صالح لبرنامج ثابت QMK لـ RP2040. تأكد من اختيار ملف .bin الناتج عن 'qmk compile'، وليس ملف .uf2 أو .hex أو أي تنسيق آخر."

#: polyhost/device/hid_fw_up.py:51
#, python-brace-format
msgid "Invalid ARM vector table: initial SP {sp} is outside RP2040 SRAM ({sram}). This does not appear to be a valid RP2040 firmware binary."
msgstr "جدول متجهات ARM غير صالح: قيمة SP الأولية {sp} تقع خارج ذاكرة SRAM لـ RP2040 ({sram}). لا يبدو أن هذا ملف ثنائي صالح لبرنامج ثابت RP2040."

#: polyhost/device/hid_fw_up.py:54
msgid "This firmware binary does not appear to be built for PolyKybd. No PolyKybd identifier string was found in the binary. Make sure you selected a firmware compiled for 'polykybd/split72' using 'qmk compile'."
msgstr "لا يبدو أن ملف البرنامج الثابت الثنائي هذا مبني لـ PolyKybd. لم يُعثر على سلسلة تعريف PolyKybd في الملف الثنائي. تأكد من اختيار برنامج ثابت مُترجَم لـ 'polykybd/split72' باستخدام 'qmk compile'."

#: polyhost/device/hid_fw_up.py:59
#, python-brace-format
msgid ""
"No signature file was found next to this image ({sig}).\n"
"\n"
"The keyboard will ask you to confirm it physically: every keycap goes dark except a big A (accept) on the left half and R (reject) on the right. That is expected for a firmware you built yourself.\n"
"\n"
"If you meant to flash a release, download its '.sig' file into the same folder as the '.bin' first."
msgstr ""
"لم يُعثر على ملف توقيع بجوار هذه الصورة ({sig}).\n"
"\n"
"ستطلب منك لوحة المفاتيح التأكيد فعليًا: تنطفئ كل أغطية المفاتيح باستثناء حرف A (قبول) كبير على النصف الأيسر وR (رفض) على الأيمن. هذا متوقع لبرنامج ثابت بنيته بنفسك.\n"
"\n"
"إذا كنت تقصد كتابة إصدار رسمي، فنزّل ملف '.sig' الخاص به أولًا إلى المجلد نفسه الذي يحتوي ملف '.bin'."

#: polyhost/device/hid_fw_up.py:65
#, python-brace-format
msgid "Cannot read {sig}: {error}"
msgstr "تعذّرت قراءة {sig}: {error}"

#: polyhost/device/hid_fw_up.py:67
#, python-brace-format
msgid "{sig} is {size} bytes, but a signature is exactly {expected}. It will be ignored and the keyboard will ask you to confirm the image physically."
msgstr "حجم {sig} هو {size} بايت، لكن التوقيع يبلغ {expected} بالضبط. سيتم تجاهله وستطلب منك لوحة المفاتيح تأكيد الصورة فعليًا."

#: polyhost/device/hid_fw_up.py:69
msgid "Firmware file is empty."
msgstr "ملف البرنامج الثابت فارغ."

#: polyhost/device/hid_fw_up.py:70
#, python-brace-format
msgid "Firmware too large: {size} bytes (max {max_kb} KB)."
msgstr "البرنامج الثابت كبير جدًا: {size} بايت (الحد الأقصى {max_kb} KB)."

#: polyhost/device/hid_fw_up.py:71
#, python-brace-format
msgid "Sending FW_UP_BEGIN — {kb} KB, CRC32 {crc}…"
msgstr "جارٍ إرسال FW_UP_BEGIN — {kb} KB، CRC32 {crc}…"

#: polyhost/device/hid_fw_up.py:72
#, python-brace-format
msgid "{step} — {elapsed}s elapsed…"
msgstr "{step} — مضى {elapsed}s…"

#: polyhost/device/hid_fw_up.py:73
msgid "Erasing staging area — keyboard will reconnect when done"
msgstr "جارٍ مسح منطقة التجهيز — ستُعيد لوحة المفاتيح الاتصال عند الانتهاء"

#: polyhost/device/hid_fw_up.py:74
msgid "Erasing staging area (both halves)"
msgstr "جارٍ مسح منطقة التجهيز (كلا النصفين)"

#: polyhost/device/hid_fw_up.py:75
msgid "FW_UP_BEGIN timed out"
msgstr "انتهت مهلة FW_UP_BEGIN"

#: polyhost/device/hid_fw_up.py:76
msgid "staging area"
msgstr "منطقة التجهيز"

#: polyhost/device/hid_fw_up.py:78
msgid "FW_UP_BEGIN timed out — keyboard did not finish erasing within 90 s.  Check the USB cable and try again."
msgstr "انتهت مهلة FW_UP_BEGIN — لم تُنهِ لوحة المفاتيح المسح خلال 90 s. افحص كابل USB وحاول مرة أخرى."

#: polyhost/device/hid_fw_up.py:81
msgid "FW_UP_BEGIN failed — keyboard did not reconnect within 30 s.  Check the USB cable and try again."
msgstr "فشل FW_UP_BEGIN — لم تُعِد لوحة المفاتيح الاتصال خلال 30 s. افحص كابل USB وحاول مرة أخرى."

#: polyhost/device/hid_fw_up.py:84
msgid ""
"FW_UP_BEGIN failed — the slave half could not be prepared.\n"
"Ensure both keyboard halves are connected and powered on.\n"
"If the slave half has old firmware (without HID firmware update support), it must be\n"
"flashed manually via UF2 before HID firmware update will work."
msgstr ""
"فشل FW_UP_BEGIN — تعذّر تجهيز النصف التابع.\n"
"تأكد من توصيل كلا نصفي لوحة المفاتيح وتشغيلهما.\n"
"إذا كان النصف التابع يحمل برنامجًا ثابتًا قديمًا (دون دعم تحديث البرنامج الثابت عبر HID)، فيجب\n"
"كتابته يدويًا عبر UF2 قبل أن يعمل تحديث البرنامج الثابت عبر HID."

#: polyhost/device/hid_fw_up.py:88
#, python-brace-format
msgid "Staging erased. Sending {chunks} chunks…"
msgstr "تم مسح منطقة التجهيز. جارٍ إرسال {chunks} جزءًا…"

#: polyhost/device/hid_fw_up.py:89
msgid "Update cancelled by user."
msgstr "ألغى المستخدم التحديث."

#: polyhost/device/hid_fw_up.py:90
#, python-brace-format
msgid "Chunk {n}/{total} ({kb} KB sent)…"
msgstr "الجزء {n}/{total} (أُرسل {kb} KB)…"

#: polyhost/device/hid_fw_up.py:92
#, python-brace-format
msgid "Keyboard halves resynced — rewinding to chunk {n}/{total} (offset {offset}, resync {resync})…"
msgstr "أُعيدت مزامنة نصفي لوحة المفاتيح — الرجوع إلى الجزء {n}/{total} (الإزاحة {offset}، إعادة المزامنة {resync})…"

#: polyhost/device/hid_fw_up.py:94
msgid "keyboard rejected the chunk"
msgstr "رفضت لوحة المفاتيح الجزء"

#: polyhost/device/hid_fw_up.py:95
msgid "no reply from the keyboard"
msgstr "لا يوجد رد من لوحة المفاتيح"

#: polyhost/device/hid_fw_up.py:97
#, python-brace-format
msgid ""
"FW_UP_CHUNK failed at offset {offset} after {attempts} attempts — {reason}.\n"
"Ensure both keyboard halves are connected and running the same firmware, then try again — the update resumes from scratch and is safe to repeat."
msgstr ""
"فشل FW_UP_CHUNK عند الإزاحة {offset} بعد {attempts} محاولات — {reason}.\n"
"تأكد من توصيل كلا نصفي لوحة المفاتيح وأنهما يشغّلان البرنامج الثابت نفسه، ثم حاول مرة أخرى — يبدأ التحديث من البداية ويمكن تكراره بأمان."

#: polyhost/device/hid_fw_up.py:100
#, python-brace-format
msgid "Chunk {n}/{total} — retry {attempt}/{max_attempts} (waiting {ms} ms)…"
msgstr "الجزء {n}/{total} — إعادة المحاولة {attempt}/{max_attempts} (انتظار {ms} ms)…"

#: polyhost/device/hid_fw_up.py:101
#, python-brace-format
msgid "Sending over the fast link: {kb} KB of {total_kb} KB…"
msgstr "الإرسال عبر الوصلة السريعة: {kb} KB من {total_kb} KB…"

#: polyhost/device/hid_fw_up.py:102
#, python-brace-format
msgid "Fast link stopped ({reason}); continuing over HID from {kb} KB."
msgstr "توقفت الوصلة السريعة ({reason})؛ المتابعة عبر HID من {kb} KB."

#: polyhost/device/hid_fw_up.py:106
msgid "port not openable"
msgstr "تعذر فتح المنفذ"

#: polyhost/device/hid_fw_up.py:107
msgid "pipe protocol too old"
msgstr "بروتوكول القناة قديم جدًا"

#: polyhost/device/hid_fw_up.py:108
msgid "port error"
msgstr "خطأ في المنفذ"

#: polyhost/device/hid_fw_up.py:109
#, python-brace-format
msgid "Could not read {sig}: {error} — flashing unsigned."
msgstr "تعذّرت قراءة {sig}: {error} — ستتم الكتابة دون توقيع."

#: polyhost/device/hid_fw_up.py:110
msgid "Sending image signature…"
msgstr "جارٍ إرسال توقيع الصورة…"

#: polyhost/device/hid_fw_up.py:111
#, python-brace-format
msgid "Ignoring {sig} — expected {expected} bytes, got {size}."
msgstr "تجاهل {sig} — المتوقع {expected} بايت، والفعلي {size}."

#: polyhost/device/hid_fw_up.py:112
msgid "Verifying the staged image (CRC32)…"
msgstr "جارٍ التحقق من الصورة المُجهَّزة (CRC32)…"

#: polyhost/device/hid_fw_up.py:114
msgid "This firmware is not signed. Confirm on the KEYBOARD: press the highlighted A (accept) or R (reject) key."
msgstr "هذا البرنامج الثابت غير موقَّع. أكّد على لوحة المفاتيح: اضغط المفتاح المميَّز A (قبول) أو R (رفض)."

#: polyhost/device/hid_fw_up.py:117
msgid ""
"Timed out waiting for confirmation on the keyboard.\n"
"\n"
"The keyboard asks for a physical ACCEPT/REJECT because this image is not validly signed. Start the flash again and press the highlighted A key on the left half within a minute."
msgstr ""
"انتهت مهلة انتظار التأكيد على لوحة المفاتيح.\n"
"\n"
"تطلب لوحة المفاتيح قبولًا أو رفضًا فعليًا (ACCEPT/REJECT) لأن هذه الصورة غير موقَّعة توقيعًا صالحًا. ابدأ الكتابة مرة أخرى واضغط المفتاح المميَّز A على النصف الأيسر خلال دقيقة."

#: polyhost/device/hid_fw_up.py:122
#, python-brace-format
msgid ""
"The keyboard refused this firmware: the signature does not match the image.\n"
"\n"
"{sig} is not a valid signature for this .bin. Either the two files come from different builds, or one of them is damaged — re-download both from the same release.\n"
"\n"
"There is deliberately no way to confirm past this on the keyboard: a signature that fails to verify means the file is not what it claims to be."
msgstr ""
"رفضت لوحة المفاتيح هذا البرنامج الثابت: التوقيع لا يطابق الصورة.\n"
"\n"
"{sig} ليس توقيعًا صالحًا لملف .bin هذا. إما أن الملفين من بنيتين مختلفتين، أو أن أحدهما تالف — نزّل الملفين مجددًا من الإصدار نفسه.\n"
"\n"
"لا توجد عمدًا أي طريقة لتجاوز ذلك بالتأكيد على لوحة المفاتيح: التوقيع الذي يفشل التحقق منه يعني أن الملف ليس ما يدّعيه."

#: polyhost/device/hid_fw_up.py:131
msgid ""
"The keyboard refused this firmware: it is not signed.\n"
"\n"
"Released firmware ships a matching '.sig' file — download it next to the .bin and flash again.\n"
"\n"
"To flash a build you compiled yourself, flash again and press the highlighted A (accept) key on the keyboard when it asks."
msgstr ""
"رفضت لوحة المفاتيح هذا البرنامج الثابت: إنه غير موقَّع.\n"
"\n"
"يأتي البرنامج الثابت المنشور مع ملف '.sig' مطابق — نزّله بجانب ملف .bin وأعد الكتابة.\n"
"\n"
"لكتابة إصدار بنيته بنفسك، أعد الكتابة واضغط المفتاح المميَّز A (قبول) على لوحة المفاتيح عندما تطلب ذلك."

#: polyhost/device/hid_fw_up.py:136
msgid "FW_UP_COMMIT failed — CRC mismatch on keyboard. Try again."
msgstr "فشل FW_UP_COMMIT — عدم تطابق CRC على لوحة المفاتيح. حاول مرة أخرى."

#: polyhost/device/hid_fw_up.py:137
msgid "Done. New firmware staged and verified on the keyboard."
msgstr "تم. جُهِّز البرنامج الثابت الجديد وتم التحقق منه على لوحة المفاتيح."

#: polyhost/device/hid_fw_up.py:139
msgid ""
"Firmware staged and verified successfully.\n"
"\n"
"The new image is stored and CRC-checked on the keyboard, but it is not active yet — the keyboard is still running its current firmware. Activating the staged image will be a separate step."
msgstr ""
"تم تجهيز البرنامج الثابت والتحقق منه بنجاح.\n"
"\n"
"الصورة الجديدة مخزّنة على لوحة المفاتيح وتم فحص CRC لها، لكنها ليست نشطة بعد — لا تزال لوحة المفاتيح تشغّل برنامجها الثابت الحالي. سيكون تنشيط الصورة المُجهَّزة خطوة منفصلة."

#: polyhost/device/hid_fw_up.py:143
msgid "Sending FW_UP_APPLY…"
msgstr "جارٍ إرسال FW_UP_APPLY…"

#: polyhost/device/hid_fw_up.py:145
msgid ""
"Apply is not available.\n"
"\n"
"The keyboard reported no valid staged image, or this firmware was built without in-app apply (FW_UP_INAPP_APPLY=no). The staged image is unchanged."
msgstr ""
"التطبيق غير متاح.\n"
"\n"
"أفادت لوحة المفاتيح بعدم وجود صورة مُجهَّزة صالحة، أو أن هذا البرنامج الثابت بُني دون التطبيق من داخل التطبيق (FW_UP_INAPP_APPLY=no). لم تتغير الصورة المُجهَّزة."

#: polyhost/device/hid_fw_up.py:149
msgid "Applying — keyboard is erasing its flash and rebooting…"
msgstr "جارٍ التطبيق — تمسح لوحة المفاتيح ذاكرة الفلاش الخاصة بها وتعيد التشغيل…"

#: polyhost/device/hid_fw_up.py:151
msgid ""
"Keyboard did not reconnect within 30 s after apply.\n"
"If it does not come back on its own, hold BOOTSEL on the master half and re-flash the .uf2."
msgstr ""
"لم تُعِد لوحة المفاتيح الاتصال خلال 30 s بعد التطبيق.\n"
"إذا لم تعد من تلقاء نفسها، فاضغط مطولًا على BOOTSEL في النصف الرئيسي وأعد كتابة ملف .uf2."

#: polyhost/device/hid_fw_up.py:155
msgid ""
"The keyboard acknowledged APPLY but did not reboot within 10 s.\n"
"The staged image was not applied; the keyboard still runs its current firmware. Try the apply again."
msgstr ""
"أكدت لوحة المفاتيح APPLY لكنها لم تُعِد التشغيل خلال 10 s.\n"
"لم تُطبَّق الصورة المُجهَّزة؛ لا تزال لوحة المفاتيح تشغّل برنامجها الثابت الحالي. أعد محاولة التطبيق."

#: polyhost/device/hid_fw_up.py:158
msgid "Done. Keyboard reconnected on the applied firmware."
msgstr "تم. أعادت لوحة المفاتيح الاتصال بالبرنامج الثابت المُطبَّق."

#: polyhost/device/hid_fw_up.py:160
msgid ""
"Firmware applied — the keyboard rebooted and reconnected.\n"
"\n"
"Both halves now run the new firmware."
msgstr ""
"تم تطبيق البرنامج الثابت — أُعيد تشغيل لوحة المفاتيح وأعادت الاتصال.\n"
"\n"
"يعمل كلا النصفين الآن بالبرنامج الثابت الجديد."

#: polyhost/device/split_link.py:30
#, python-brace-format
msgid "{prefix} — the USB half answered, but the other keyboard half did not confirm that it had erased the {what} within 90 s. Check the cable between the two halves. If the other half stays dark, it is not running firmware and needs the firmware .uf2 copied onto it by hand."
msgstr "{prefix} — استجاب النصف الموصول عبر USB، لكن نصف لوحة المفاتيح الآخر لم يؤكد أنه مسح {what} خلال 90 s. افحص الكابل بين النصفين. إذا ظل النصف الآخر مطفأً، فهو لا يشغّل أي برنامج ثابت ويحتاج إلى نسخ ملف .uf2 للبرنامج الثابت إليه يدويًا."

#: polyhost/forwarder.py:261
msgid "Press to pause forwarding"
msgstr "اضغط لإيقاف إعادة التوجيه مؤقتًا"

#: polyhost/forwarder.py:268
msgid "Stop sending this machine's active window to the keyboard machine."
msgstr "إيقاف إرسال النافذة النشطة على هذا الجهاز إلى جهاز لوحة المفاتيح."

#: polyhost/forwarder.py:283
msgid "Check for host update…"
msgstr "التحقق من وجود تحديث للمضيف…"

#: polyhost/forwarder.py:309
msgid "Set Up Agent Hooks"
msgstr "إعداد خطافات الوكلاء"

#: polyhost/forwarder.py:311
msgid "Pair with the Keyboard Computer…"
msgstr "الإقران مع حاسوب لوحة المفاتيح…"

#: polyhost/forwarder.py:393
#, python-brace-format
msgid "no host (waiting for {path})"
msgstr "لا يوجد مضيف (بانتظار {path})"

#: polyhost/forwarder.py:394
msgid "no host configured"
msgstr "لم يتم تكوين مضيف"

#: polyhost/forwarder.py:397
#, python-brace-format
msgid "PolyKybdHost {version} (forwarder) → {target}"
msgstr "PolyKybdHost {version} (مُعيد التوجيه) ← {target}"

#: polyhost/forwarder.py:402
msgid "Forwarding paused"
msgstr "إعادة التوجيه متوقفة مؤقتًا"

#: polyhost/forwarder.py:405
#, python-brace-format
msgid "Forwarding to {target}…"
msgstr "جارٍ إعادة التوجيه إلى {target}…"

#: polyhost/forwarder.py:407
#, python-brace-format
msgid "Forwarding to {target}"
msgstr "إعادة التوجيه إلى {target}"

#: polyhost/forwarder.py:408
#, python-brace-format
msgid "Cannot reach {target}"
msgstr "تعذّر الوصول إلى {target}"

#: polyhost/forwarder.py:556
msgid "The hooks are written, but this forwarder runs without --report-rpc, so it cannot pass agent reports on. Start it with --report-rpc to show this computer's agents on the keys."
msgstr "تمت كتابة الخطافات، لكن مُعيد التوجيه هذا يعمل بدون --report-rpc، لذا لا يمكنه تمرير تقارير الوكلاء. شغّله مع --report-rpc لعرض وكلاء هذا الحاسوب على المفاتيح."

#: polyhost/forwarder.py:559
msgid "The hooks are written. On the keyboard computer, turn on Settings > AI agents > \"Agents from other computers\"."
msgstr "تمت كتابة الخطافات. على حاسوب لوحة المفاتيح، شغّل الإعدادات > وكلاء الذكاء الاصطناعي > «الوكلاء من حواسيب أخرى»."

#: polyhost/forwarder.py:890
msgid "PolyForwarder settings"
msgstr "إعدادات PolyForwarder"

#: polyhost/forwarder.py:891
msgid "The settings could not be saved to the settings file, so they will not take effect. Another program may be holding it open. Try again, or see the log."
msgstr "تعذّر حفظ الإعدادات في ملف الإعدادات، لذا لن تسري. قد يكون برنامج آخر يُبقي الملف مفتوحًا. حاول مرة أخرى، أو راجع السجل."

#: polyhost/forwarder.py:909
msgid "Paired. The forwarder uses the authenticated connection from its next start. Restart it now?"
msgstr "تم الإقران. يستخدم مُعيد التوجيه الاتصال الموثّق بدءًا من تشغيله التالي. هل تريد إعادة تشغيله الآن؟"

#: polyhost/forwarder.py:924
#, python-brace-format
msgid "authenticated RPC (port {port})"
