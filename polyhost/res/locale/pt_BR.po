"The download failed:\n"
"\n"
"{error}"
msgstr ""
"O download falhou:\n"
"\n"
"{error}"

#: polyhost/host.py:3416
#, python-brace-format
msgid ""
"The installer could not be started:\n"
"\n"
"{error}\n"
"\n"
"It was saved to:\n"
"{path}"
msgstr ""
