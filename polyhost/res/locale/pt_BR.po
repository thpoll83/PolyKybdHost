#: polyhost/device/command_ids.py:183
#, python-brace-format
msgid "preset {value}"
msgstr "predefinição {value}"

#: polyhost/device/command_ids.py:185
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} min"

#: polyhost/device/command_ids.py:186
#, python-brace-format
msgid "{seconds} sec"
msgstr "{seconds} s"

#: polyhost/device/hid_fw_up.py:43
#, python-brace-format
msgid "File is too small ({size} bytes) to be a valid RP2040 firmware image (expected at least 264 bytes for boot2 + ARM vector table)."
msgstr "O arquivo é pequeno demais ({size} bytes) para ser uma imagem de firmware RP2040 válida (esperado pelo menos 264 bytes para boot2 + tabela de vetores ARM)."

#: polyhost/device/hid_fw_up.py:46
#, python-brace-format
msgid "Invalid RP2040 boot2 CRC32 (file has {stored}, computed {computed}). This does not appear to be a valid RP2040 QMK firmware .bin. Make sure you select the .bin produced by 'qmk compile', not a .uf2, .hex, or other format."
msgstr "CRC32 do boot2 do RP2040 inválido (o arquivo tem {stored}, calculado {computed}). Este não parece ser um .bin de firmware QMK para RP2040 válido. Selecione o .bin gerado por 'qmk compile', e não um .uf2, .hex ou outro formato."

#: polyhost/device/hid_fw_up.py:51
#, python-brace-format
msgid "Invalid ARM vector table: initial SP {sp} is outside RP2040 SRAM ({sram}). This does not appear to be a valid RP2040 firmware binary."
msgstr "Tabela de vetores ARM inválida: o SP inicial {sp} está fora da SRAM do RP2040 ({sram}). Este não parece ser um binário de firmware RP2040 válido."

#: polyhost/device/hid_fw_up.py:54
msgid "This firmware binary does not appear to be built for PolyKybd. No PolyKybd identifier string was found in the binary. Make sure you selected a firmware compiled for 'polykybd/split72' using 'qmk compile'."
msgstr "Este binário de firmware não parece ter sido compilado para o PolyKybd. Nenhuma string de identificação do PolyKybd foi encontrada no binário. Selecione um firmware compilado para 'polykybd/split72' com 'qmk compile'."

#: polyhost/device/hid_fw_up.py:59
#, python-brace-format
msgid ""
"No signature file was found next to this image ({sig}).\n"
"\n"
"The keyboard will ask you to confirm it physically: every keycap goes dark except a big A (accept) on the left half and R (reject) on the right. That is expected for a firmware you built yourself.\n"
"\n"
"If you meant to flash a release, download its '.sig' file into the same folder as the '.bin' first."
msgstr ""
"Nenhum arquivo de assinatura foi encontrado ao lado desta imagem ({sig}).\n"
"\n"
"O teclado pedirá que você confirme fisicamente: todas as teclas se apagam, exceto um A (aceitar) grande na metade esquerda e um R (rejeitar) na direita. Isso é esperado para um firmware que você mesmo compilou.\n"
"\n"
"Se você pretendia gravar uma versão publicada, baixe primeiro o arquivo '.sig' dela para a mesma pasta do '.bin'."

#: polyhost/device/hid_fw_up.py:65
#, python-brace-format
msgid "Cannot read {sig}: {error}"
msgstr "Não é possível ler {sig}: {error}"

#: polyhost/device/hid_fw_up.py:67
#, python-brace-format
msgid "{sig} is {size} bytes, but a signature is exactly {expected}. It will be ignored and the keyboard will ask you to confirm the image physically."
msgstr "{sig} tem {size} bytes, mas uma assinatura tem exatamente {expected}. Ele será ignorado e o teclado pedirá que você confirme a imagem fisicamente."

#: polyhost/device/hid_fw_up.py:69
msgid "Firmware file is empty."
msgstr "O arquivo de firmware está vazio."

#: polyhost/device/hid_fw_up.py:70
#, python-brace-format
msgid "Firmware too large: {size} bytes (max {max_kb} KB)."
msgstr "Firmware grande demais: {size} bytes (máx. {max_kb} KB)."

#: polyhost/device/hid_fw_up.py:71
#, python-brace-format
msgid "Sending FW_UP_BEGIN — {kb} KB, CRC32 {crc}…"
msgstr "Enviando FW_UP_BEGIN — {kb} KB, CRC32 {crc}…"

#: polyhost/device/hid_fw_up.py:72
#, python-brace-format
msgid "{step} — {elapsed}s elapsed…"
msgstr "{step} — {elapsed} s decorridos…"

#: polyhost/device/hid_fw_up.py:73
msgid "Erasing staging area — keyboard will reconnect when done"
msgstr "Apagando a área de preparação — o teclado vai se reconectar ao terminar"

#: polyhost/device/hid_fw_up.py:74
msgid "Erasing staging area (both halves)"
msgstr "Apagando a área de preparação (ambas as metades)"

#: polyhost/device/hid_fw_up.py:75
msgid "FW_UP_BEGIN timed out"
msgstr "Tempo esgotado em FW_UP_BEGIN"

#: polyhost/device/hid_fw_up.py:76
msgid "staging area"
msgstr "área de preparação"

#: polyhost/device/hid_fw_up.py:78
msgid "FW_UP_BEGIN timed out — keyboard did not finish erasing within 90 s.  Check the USB cable and try again."
msgstr "Tempo esgotado em FW_UP_BEGIN — o teclado não terminou de apagar em 90 s.  Verifique o cabo USB e tente novamente."

#: polyhost/device/hid_fw_up.py:81
msgid "FW_UP_BEGIN failed — keyboard did not reconnect within 30 s.  Check the USB cable and try again."
msgstr "FW_UP_BEGIN falhou — o teclado não se reconectou em 30 s.  Verifique o cabo USB e tente novamente."

#: polyhost/device/hid_fw_up.py:84
msgid ""
"FW_UP_BEGIN failed — the slave half could not be prepared.\n"
"Ensure both keyboard halves are connected and powered on.\n"
"If the slave half has old firmware (without HID firmware update support), it must be\n"
"flashed manually via UF2 before HID firmware update will work."
msgstr ""
"FW_UP_BEGIN falhou — não foi possível preparar a metade escrava.\n"
"Verifique se as duas metades do teclado estão conectadas e ligadas.\n"
"Se a metade escrava tiver um firmware antigo (sem suporte a atualização de firmware via HID), ela precisa ser\n"
"gravada manualmente via UF2 antes que a atualização de firmware via HID funcione."

#: polyhost/device/hid_fw_up.py:88
#, python-brace-format
msgid "Staging erased. Sending {chunks} chunks…"
msgstr "Área de preparação apagada. Enviando {chunks} blocos…"

#: polyhost/device/hid_fw_up.py:89
msgid "Update cancelled by user."
msgstr "Atualização cancelada pelo usuário."

#: polyhost/device/hid_fw_up.py:90
#, python-brace-format
msgid "Chunk {n}/{total} ({kb} KB sent)…"
msgstr "Bloco {n}/{total} ({kb} KB enviados)…"

#: polyhost/device/hid_fw_up.py:92
#, python-brace-format
msgid "Keyboard halves resynced — rewinding to chunk {n}/{total} (offset {offset}, resync {resync})…"
msgstr "Metades do teclado ressincronizadas — voltando ao bloco {n}/{total} (deslocamento {offset}, resync {resync})…"

#: polyhost/device/hid_fw_up.py:94
msgid "keyboard rejected the chunk"
msgstr "o teclado rejeitou o bloco"

#: polyhost/device/hid_fw_up.py:95
msgid "no reply from the keyboard"
msgstr "nenhuma resposta do teclado"

#: polyhost/device/hid_fw_up.py:97
#, python-brace-format
msgid ""
"FW_UP_CHUNK failed at offset {offset} after {attempts} attempts — {reason}.\n"
"Ensure both keyboard halves are connected and running the same firmware, then try again — the update resumes from scratch and is safe to repeat."
msgstr ""
"FW_UP_CHUNK falhou no deslocamento {offset} após {attempts} tentativas — {reason}.\n"
"Verifique se as duas metades do teclado estão conectadas e executando o mesmo firmware e tente novamente — a atualização recomeça do zero e pode ser repetida com segurança."

#: polyhost/device/hid_fw_up.py:100
#, python-brace-format
msgid "Chunk {n}/{total} — retry {attempt}/{max_attempts} (waiting {ms} ms)…"
msgstr "Bloco {n}/{total} — nova tentativa {attempt}/{max_attempts} (aguardando {ms} ms)…"

#: polyhost/device/hid_fw_up.py:101
#, python-brace-format
msgid "Sending over the fast link: {kb} KB of {total_kb} KB…"
msgstr "Enviando pelo link rápido: {kb} KB de {total_kb} KB…"

#: polyhost/device/hid_fw_up.py:102
#, python-brace-format
msgid "Fast link stopped ({reason}); continuing over HID from {kb} KB."
msgstr "O link rápido parou ({reason}); continuando por HID a partir de {kb} KB."

#: polyhost/device/hid_fw_up.py:106
msgid "port not openable"
msgstr "não foi possível abrir a porta"

#: polyhost/device/hid_fw_up.py:107
msgid "pipe protocol too old"
msgstr "protocolo do canal muito antigo"

#: polyhost/device/hid_fw_up.py:108
msgid "port error"
msgstr "erro na porta"

#: polyhost/device/hid_fw_up.py:109
#, python-brace-format
msgid "Could not read {sig}: {error} — flashing unsigned."
msgstr "Não foi possível ler {sig}: {error} — gravando sem assinatura."

#: polyhost/device/hid_fw_up.py:110
msgid "Sending image signature…"
msgstr "Enviando a assinatura da imagem…"

#: polyhost/device/hid_fw_up.py:111
#, python-brace-format
msgid "Ignoring {sig} — expected {expected} bytes, got {size}."
msgstr "Ignorando {sig} — esperados {expected} bytes, recebidos {size}."

#: polyhost/device/hid_fw_up.py:112
msgid "Verifying the staged image (CRC32)…"
msgstr "Verificando a imagem preparada (CRC32)…"

#: polyhost/device/hid_fw_up.py:114
msgid "This firmware is not signed. Confirm on the KEYBOARD: press the highlighted A (accept) or R (reject) key."
msgstr "Este firmware não está assinado. Confirme no TECLADO: pressione a tecla destacada A (aceitar) ou R (rejeitar)."

#: polyhost/device/hid_fw_up.py:117
msgid ""
"Timed out waiting for confirmation on the keyboard.\n"
"\n"
"The keyboard asks for a physical ACCEPT/REJECT because this image is not validly signed. Start the flash again and press the highlighted A key on the left half within a minute."
msgstr ""
"Tempo esgotado aguardando a confirmação no teclado.\n"
"\n"
"O teclado pede um ACEITAR/REJEITAR físico porque esta imagem não tem uma assinatura válida. Inicie a gravação novamente e pressione a tecla A destacada na metade esquerda em até um minuto."

#: polyhost/device/hid_fw_up.py:122
#, python-brace-format
msgid ""
"The keyboard refused this firmware: the signature does not match the image.\n"
"\n"
"{sig} is not a valid signature for this .bin. Either the two files come from different builds, or one of them is damaged — re-download both from the same release.\n"
"\n"
"There is deliberately no way to confirm past this on the keyboard: a signature that fails to verify means the file is not what it claims to be."
msgstr ""
"O teclado recusou este firmware: a assinatura não corresponde à imagem.\n"
"\n"
"{sig} não é uma assinatura válida para este .bin. Ou os dois arquivos vêm de compilações diferentes, ou um deles está danificado — baixe os dois novamente da mesma versão.\n"
"\n"
"Propositalmente, não há como confirmar mesmo assim no teclado: uma assinatura que não pode ser verificada significa que o arquivo não é o que diz ser."

#: polyhost/device/hid_fw_up.py:131
msgid ""
"The keyboard refused this firmware: it is not signed.\n"
"\n"
"Released firmware ships a matching '.sig' file — download it next to the .bin and flash again.\n"
"\n"
"To flash a build you compiled yourself, flash again and press the highlighted A (accept) key on the keyboard when it asks."
msgstr ""
"O teclado recusou este firmware: ele não está assinado.\n"
"\n"
"O firmware lançado inclui um arquivo '.sig' correspondente — baixe-o para a mesma pasta do .bin e grave novamente.\n"
"\n"
"Para gravar uma versão que você mesmo compilou, grave novamente e pressione a tecla A (aceitar) destacada no teclado quando ele pedir."

#: polyhost/device/hid_fw_up.py:136
msgid "FW_UP_COMMIT failed — CRC mismatch on keyboard. Try again."
msgstr "FW_UP_COMMIT falhou — CRC divergente no teclado. Tente novamente."

#: polyhost/device/hid_fw_up.py:137
msgid "Done. New firmware staged and verified on the keyboard."
msgstr "Pronto. Novo firmware preparado e verificado no teclado."

#: polyhost/device/hid_fw_up.py:139
msgid ""
"Firmware staged and verified successfully.\n"
"\n"
"The new image is stored and CRC-checked on the keyboard, but it is not active yet — the keyboard is still running its current firmware. Activating the staged image will be a separate step."
msgstr ""
"Firmware preparado e verificado com sucesso.\n"
"\n"
"A nova imagem está armazenada e verificada por CRC no teclado, mas ainda não está ativa — o teclado continua executando o firmware atual. Ativar a imagem preparada será uma etapa separada."

#: polyhost/device/hid_fw_up.py:143
msgid "Sending FW_UP_APPLY…"
msgstr "Enviando FW_UP_APPLY…"

#: polyhost/device/hid_fw_up.py:145
msgid ""
"Apply is not available.\n"
"\n"
"The keyboard reported no valid staged image, or this firmware was built without in-app apply (FW_UP_INAPP_APPLY=no). The staged image is unchanged."
msgstr ""
"A aplicação não está disponível.\n"
"\n"
"O teclado não informou nenhuma imagem preparada válida, ou este firmware foi compilado sem aplicação integrada (FW_UP_INAPP_APPLY=no). A imagem preparada não foi alterada."

#: polyhost/device/hid_fw_up.py:149
msgid "Applying — keyboard is erasing its flash and rebooting…"
msgstr "Aplicando — o teclado está apagando a flash e reiniciando…"

#: polyhost/device/hid_fw_up.py:151
msgid ""
"Keyboard did not reconnect within 30 s after apply.\n"
"If it does not come back on its own, hold BOOTSEL on the master half and re-flash the .uf2."
msgstr ""
"O teclado não se reconectou em 30 s após a aplicação.\n"
"Se ele não voltar sozinho, mantenha BOOTSEL pressionado na metade mestre e grave o .uf2 novamente."

#: polyhost/device/hid_fw_up.py:155
msgid ""
"The keyboard acknowledged APPLY but did not reboot within 10 s.\n"
"The staged image was not applied; the keyboard still runs its current firmware. Try the apply again."
msgstr ""
"O teclado confirmou APPLY, mas não reiniciou em 10 s.\n"
"A imagem preparada não foi aplicada; o teclado continua executando o firmware atual. Tente aplicar novamente."

#: polyhost/device/hid_fw_up.py:158
msgid "Done. Keyboard reconnected on the applied firmware."
msgstr "Pronto. O teclado se reconectou com o firmware aplicado."

#: polyhost/device/hid_fw_up.py:160
msgid ""
"Firmware applied — the keyboard rebooted and reconnected.\n"
"\n"
"Both halves now run the new firmware."
msgstr ""
"Firmware aplicado — o teclado reiniciou e se reconectou.\n"
"\n"
"As duas metades agora executam o novo firmware."

#: polyhost/device/split_link.py:30
#, python-brace-format
msgid "{prefix} — the USB half answered, but the other keyboard half did not confirm that it had erased the {what} within 90 s. Check the cable between the two halves. If the other half stays dark, it is not running firmware and needs the firmware .uf2 copied onto it by hand."
msgstr "{prefix} — a metade USB respondeu, mas a outra metade do teclado não confirmou ter apagado a {what} em 90 s. Verifique o cabo entre as duas metades. Se a outra metade continuar apagada, ela não está executando nenhum firmware e precisa que o .uf2 do firmware seja copiado para ela manualmente."

#: polyhost/forwarder.py:261
msgid "Press to pause forwarding"
msgstr "Clique para pausar o encaminhamento"

#: polyhost/forwarder.py:268
msgid "Stop sending this machine's active window to the keyboard machine."
msgstr "Parar de enviar a janela ativa deste computador para o computador do teclado."

#: polyhost/forwarder.py:281
msgid "Check for host update…"
msgstr "Verificar atualização do host…"

#: polyhost/forwarder.py:297
msgid "Pair with the Keyboard Computer…"
msgstr "Parear com o computador do teclado…"

#: polyhost/forwarder.py:390
#, python-brace-format
msgid "no host (waiting for {path})"
msgstr "nenhum host (aguardando {path})"

#: polyhost/forwarder.py:391
msgid "no host configured"
msgstr "nenhum host configurado"

#: polyhost/forwarder.py:394
#, python-brace-format
msgid "PolyKybdHost {version} (forwarder) → {target}"
msgstr "PolyKybdHost {version} (encaminhador) → {target}"

#: polyhost/forwarder.py:399
msgid "Forwarding paused"
msgstr "Encaminhamento pausado"

#: polyhost/forwarder.py:402
#, python-brace-format
msgid "Forwarding to {target}…"
msgstr "Encaminhando para {target}…"

#: polyhost/forwarder.py:404
#, python-brace-format
msgid "Forwarding to {target}"
msgstr "Encaminhando para {target}"

#: polyhost/forwarder.py:405
#, python-brace-format
msgid "Cannot reach {target}"
msgstr "Não é possível alcançar {target}"

#: polyhost/forwarder.py:553
msgid "The hooks are written, but this forwarder runs without --report-rpc, so it cannot pass agent reports on. Start it with --report-rpc to show this computer's agents on the keys."
msgstr "Os hooks foram gravados, mas este encaminhador está em execução sem --report-rpc, então não pode repassar os relatórios de agentes. Inicie-o com --report-rpc para mostrar os agentes deste computador nas teclas."

#: polyhost/forwarder.py:556
msgid "The hooks are written. On the keyboard computer, turn on Settings > AI agents > \"Agents from other computers\"."
msgstr "Os hooks foram gravados. No computador do teclado, ative Configurações > Agentes de IA > “Agentes de outros computadores”."

#: polyhost/forwarder.py:885
msgid "PolyForwarder settings"
msgstr "Configurações do PolyForwarder"

#: polyhost/forwarder.py:886
msgid "The settings could not be saved to the settings file, so they will not take effect. Another program may be holding it open. Try again, or see the log."
msgstr "Não foi possível salvar as configurações no arquivo de configurações, portanto elas não terão efeito. Outro programa pode estar com o arquivo aberto. Tente novamente ou consulte o log."

#: polyhost/forwarder.py:904
msgid "Paired. The forwarder uses the authenticated connection from its next start. Restart it now?"
msgstr "Pareado. O encaminhador usa a conexão autenticada a partir do próximo início. Reiniciá-lo agora?"

#: polyhost/forwarder.py:919
#, python-brace-format
msgid "authenticated RPC (port {port})"
msgstr "RPC autenticado (porta {port})"

#: polyhost/forwarder.py:921
msgid "legacy plaintext TCP relay"
msgstr "relay TCP legado em texto simples"

#: polyhost/forwarder.py:924
msgid "reaching the keyboard machine"
msgstr "alcançando o computador do teclado"

#: polyhost/forwarder.py:925
msgid "not reaching the keyboard machine"
msgstr "sem alcançar o computador do teclado"

#: polyhost/forwarder.py:926
msgid "starting up"
msgstr "iniciando"

#: polyhost/forwarder.py:928
msgid "<b>Mode:</b> forwarder — no keyboard attached to this machine"
msgstr "<b>Modo:</b> encaminhador — nenhum teclado conectado a este computador"

#: polyhost/forwarder.py:929
#, python-brace-format
msgid "<b>Target:</b> {target}"
msgstr "<b>Destino:</b> {target}"

#: polyhost/forwarder.py:931
#, python-brace-format
msgid "<b>Window reports:</b> {transport}"
msgstr "<b>Relatórios de janela:</b> {transport}"

#: polyhost/forwarder.py:934
#, python-brace-format
msgid "<b>Host file:</b> {path}"
msgstr "<b>Arquivo de host:</b> {path}"

#: polyhost/forwarder.py:955
msgid "About PolyKybdHost (forwarder)"
msgstr "Sobre o PolyKybdHost (encaminhador)"

#. TRANSLATORS: the run mode in the About dialog's environment line
#: polyhost/forwarder.py:962
msgid "forwarder"
msgstr "encaminhador"

#: polyhost/forwarder.py:964
msgid "Forwarder mode: this machine has no keyboard. It watches the active window here and relays it to the PolyKybdHost running on the machine the keyboard is plugged into."
msgstr "Modo encaminhador: este computador não tem teclado. Ele observa a janela ativa aqui e a repassa ao PolyKybdHost em execução no computador em que o teclado está conectado."

#: polyhost/forwarder.py:1004
msgid "Download, install, and restart the forwarder now?"
msgstr "Baixar, instalar e reiniciar o encaminhador agora?"

#: polyhost/gui/about_dialog.py:47
msgid "Blog"
msgstr "Blog"

#: polyhost/gui/about_dialog.py:80
#, python-brace-format
msgid "Version {version}"
msgstr "Versão {version}"

#: polyhost/gui/about_dialog.py:105
msgid "Keycap displays and legends"
msgstr "Telas das keycaps e legendas"

#: polyhost/gui/about_dialog.py:106
msgid "Every key has a small display. What it shows is the key's legend: the character the key types and, on some keys, the character it types with Shift."
msgstr "Cada tecla tem uma pequena tela. O que ela mostra é a legenda da tecla: o caractere que a tecla digita e, em algumas teclas, o caractere que ela digita com Shift."

#: polyhost/gui/about_dialog.py:110
msgid "Keyboard language"
msgstr "Idioma do teclado"

#: polyhost/gui/about_dialog.py:111
msgid "The keycaps show the characters of the language your computer types in. When you switch the input language, the keyboard draws the new legends. The picture shows the A key in English, Russian, Arabic and Japanese."
msgstr "As keycaps mostram os caracteres do idioma em que o seu computador digita. Quando você troca o idioma de entrada, o teclado desenha as novas legendas. A imagem mostra a tecla A em inglês, russo, árabe e japonês."

#: polyhost/gui/about_dialog.py:115 polyhost/gui/tutorials_dialog.py:33
msgid "Layers"
msgstr "Camadas"

#: polyhost/gui/about_dialog.py:116
msgid "A layer gives every key a second function. While you hold a layer key such as Fn, the keys and their legends change: here the 1 key becomes F1."
msgstr "Uma camada dá a cada tecla uma segunda função. Enquanto você segura uma tecla de camada como Fn, as teclas e suas legendas mudam: aqui a tecla 1 vira F1."

#: polyhost/gui/about_dialog.py:119 polyhost/gui/cmd_menu.py:196
msgid "Overlays"
msgstr "Sobreposições"

#: polyhost/gui/about_dialog.py:120
msgid "An overlay is a set of icons for one app. While that app is in front and you hold a modifier such as Ctrl, each key shows what its shortcut does: here Ctrl+S saves in GIMP. PolyKybdHost comes with overlays for many apps. For other apps it reads the shortcuts from the app's menus (Settings, Keycap icons)."
msgstr "Uma sobreposição é um conjunto de ícones para um aplicativo. Enquanto esse aplicativo está em primeiro plano e você segura um modificador como Ctrl, cada tecla mostra o que o seu atalho faz: aqui Ctrl+S salva no GIMP. O PolyKybdHost vem com sobreposições para muitos aplicativos. Para outros aplicativos, ele lê os atalhos dos menus do aplicativo (Configurações, Ícones das keycaps)."

#: polyhost/gui/about_dialog.py:126 polyhost/gui/settings_dialog.py:86
msgid "Font packs"
msgstr "Pacotes de fontes"

#: polyhost/gui/about_dialog.py:127
msgid "The keyboard draws characters with fonts stored on the keyboard, in font packs: one for each group of scripts, and packs for symbols and emoji. PolyKybdHost sends missing or newer font packs to the keyboard when it connects."
msgstr "O teclado desenha os caracteres com fontes guardadas no teclado, em pacotes de fontes: um para cada grupo de escritas, e pacotes para símbolos e emoji. O PolyKybdHost envia ao teclado os pacotes de fontes que faltam ou que são mais novos quando ele se conecta."

#: polyhost/gui/about_dialog.py:132 polyhost/gui/cmd_menu.py:241
msgid "Firmware"
msgstr "Firmware"

#: polyhost/gui/about_dialog.py:133
msgid "The firmware is the program that runs inside the keyboard. PolyKybdHost offers new versions under Updates in the tray menu."
msgstr "O firmware é o programa que roda dentro do teclado. O PolyKybdHost oferece novas versões em Atualizações, no menu da bandeja."

#: polyhost/gui/about_dialog.py:136
msgid "Forwarder"
msgstr "Encaminhador"

#: polyhost/gui/about_dialog.py:137
