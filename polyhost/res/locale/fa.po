#: polyhost/device/command_ids.py:148
#, python-brace-format
msgid "preset {value}"
msgstr "پیش‌تنظیم {value}"

#: polyhost/device/command_ids.py:150
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} دقیقه"

#: polyhost/device/command_ids.py:151
#, python-brace-format
msgid "{seconds} sec"
msgstr "{seconds} ثانیه"

#: polyhost/device/hid_fw_up.py:43
#, python-brace-format
msgid "File is too small ({size} bytes) to be a valid RP2040 firmware image (expected at least 264 bytes for boot2 + ARM vector table)."
msgstr "فایل برای اینکه تصویر میان‌افزار معتبر RP2040 باشد بسیار کوچک است ({size} بایت) (دست‌کم 264 بایت برای boot2 + جدول بردار ARM انتظار می‌رود)."

#: polyhost/device/hid_fw_up.py:46
#, python-brace-format
msgid "Invalid RP2040 boot2 CRC32 (file has {stored}, computed {computed}). This does not appear to be a valid RP2040 QMK firmware .bin. Make sure you select the .bin produced by 'qmk compile', not a .uf2, .hex, or other format."
msgstr "CRC32 مربوط به boot2 در RP2040 نامعتبر است (در فایل {stored}، محاسبه‌شده {computed}). به نظر نمی‌رسد این یک فایل .bin معتبر میان‌افزار QMK برای RP2040 باشد. مطمئن شوید فایل .bin تولیدشده با 'qmk compile' را انتخاب کرده‌اید، نه .uf2، .hex یا قالبی دیگر."

#: polyhost/device/hid_fw_up.py:51
#, python-brace-format
msgid "Invalid ARM vector table: initial SP {sp} is outside RP2040 SRAM ({sram}). This does not appear to be a valid RP2040 firmware binary."
msgstr "جدول بردار ARM نامعتبر است: SP اولیهٔ {sp} خارج از SRAM در RP2040 ({sram}) است. به نظر نمی‌رسد این یک فایل باینری معتبر میان‌افزار RP2040 باشد."

#: polyhost/device/hid_fw_up.py:54
msgid "This firmware binary does not appear to be built for PolyKybd. No PolyKybd identifier string was found in the binary. Make sure you selected a firmware compiled for 'polykybd/split72' using 'qmk compile'."
msgstr "به نظر نمی‌رسد این فایل باینری میان‌افزار برای PolyKybd ساخته شده باشد. هیچ رشتهٔ شناسهٔ PolyKybd در فایل باینری پیدا نشد. مطمئن شوید میان‌افزاری را انتخاب کرده‌اید که برای 'polykybd/split72' با 'qmk compile' کامپایل شده است."

#: polyhost/device/hid_fw_up.py:59
#, python-brace-format
msgid ""
"No signature file was found next to this image ({sig}).\n"
"\n"
"The keyboard will ask you to confirm it physically: every keycap goes dark except a big A (accept) on the left half and R (reject) on the right. That is expected for a firmware you built yourself.\n"
"\n"
"If you meant to flash a release, download its '.sig' file into the same folder as the '.bin' first."
msgstr ""
"هیچ فایل امضایی کنار این تصویر پیدا نشد ({sig}).\n"
"\n"
"صفحه‌کلید از شما می‌خواهد آن را به‌صورت فیزیکی تأیید کنید: همهٔ کلاهک‌ها خاموش می‌شوند جز یک A (پذیرش) بزرگ روی نیمهٔ چپ و R (رد) روی نیمهٔ راست. این برای میان‌افزاری که خودتان ساخته‌اید طبیعی است.\n"
"\n"
"اگر قصد فلش یک نسخهٔ منتشرشده را داشتید، ابتدا فایل '.sig' آن را در همان پوشهٔ فایل '.bin' بارگیری کنید."

#: polyhost/device/hid_fw_up.py:65
#, python-brace-format
msgid "Cannot read {sig}: {error}"
msgstr "خواندن {sig} ممکن نیست: {error}"

#: polyhost/device/hid_fw_up.py:67
#, python-brace-format
msgid "{sig} is {size} bytes, but a signature is exactly {expected}. It will be ignored and the keyboard will ask you to confirm the image physically."
msgstr "{sig} برابر {size} بایت است، اما امضا دقیقاً {expected} است. نادیده گرفته می‌شود و صفحه‌کلید از شما می‌خواهد تصویر را به‌صورت فیزیکی تأیید کنید."

#: polyhost/device/hid_fw_up.py:69
msgid "Firmware file is empty."
msgstr "فایل میان‌افزار خالی است."

#: polyhost/device/hid_fw_up.py:70
#, python-brace-format
msgid "Firmware too large: {size} bytes (max {max_kb} KB)."
msgstr "میان‌افزار بیش از حد بزرگ است: {size} بایت (حداکثر {max_kb} KB)."

#: polyhost/device/hid_fw_up.py:71
#, python-brace-format
msgid "Sending FW_UP_BEGIN — {kb} KB, CRC32 {crc}…"
msgstr "در حال ارسال FW_UP_BEGIN — {kb} KB، CRC32 {crc}…"

#: polyhost/device/hid_fw_up.py:72
#, python-brace-format
msgid "{step} — {elapsed}s elapsed (≈10–20 s)…"
msgstr "{step} — {elapsed}s گذشته (≈10–20 s)…"

#: polyhost/device/hid_fw_up.py:73
msgid "Erasing staging area — keyboard will reconnect when done"
msgstr "در حال پاک کردن ناحیهٔ آماده‌سازی — صفحه‌کلید پس از پایان دوباره وصل می‌شود"

#: polyhost/device/hid_fw_up.py:74
msgid "Erasing staging area (both halves)"
msgstr "در حال پاک کردن ناحیهٔ آماده‌سازی (هر دو نیمه)"

#: polyhost/device/hid_fw_up.py:75
msgid "FW_UP_BEGIN timed out"
msgstr "مهلت FW_UP_BEGIN به پایان رسید"

#: polyhost/device/hid_fw_up.py:76
msgid "staging area"
msgstr "ناحیهٔ آماده‌سازی"

#: polyhost/device/hid_fw_up.py:78
msgid "FW_UP_BEGIN timed out — keyboard did not finish erasing within 90 s.  Check the USB cable and try again."
msgstr "مهلت FW_UP_BEGIN به پایان رسید — صفحه‌کلید پاک کردن را در 90 s تمام نکرد. کابل USB را بررسی کنید و دوباره امتحان کنید."

#: polyhost/device/hid_fw_up.py:81
msgid "FW_UP_BEGIN failed — keyboard did not reconnect within 30 s.  Check the USB cable and try again."
msgstr "FW_UP_BEGIN ناموفق بود — صفحه‌کلید در 30 s دوباره وصل نشد. کابل USB را بررسی کنید و دوباره امتحان کنید."

#: polyhost/device/hid_fw_up.py:84
msgid ""
"FW_UP_BEGIN failed — the slave half could not be prepared.\n"
"Ensure both keyboard halves are connected and powered on.\n"
"If the slave half has old firmware (without HID firmware update support), it must be\n"
"flashed manually via UF2 before HID firmware update will work."
msgstr ""
"FW_UP_BEGIN ناموفق بود — نیمهٔ پیرو آماده نشد.\n"
"مطمئن شوید هر دو نیمهٔ صفحه‌کلید وصل و روشن هستند.\n"
"اگر نیمهٔ پیرو میان‌افزار قدیمی (بدون پشتیبانی از به‌روزرسانی میان‌افزار از طریق HID) دارد، باید\n"
"پیش از آنکه به‌روزرسانی میان‌افزار از طریق HID کار کند، به‌صورت دستی با UF2 فلش شود."

#: polyhost/device/hid_fw_up.py:88
#, python-brace-format
msgid "Staging erased. Sending {chunks} chunks…"
msgstr "ناحیهٔ آماده‌سازی پاک شد. در حال ارسال {chunks} قطعه…"

#: polyhost/device/hid_fw_up.py:89
msgid "Update cancelled by user."
msgstr "به‌روزرسانی توسط کاربر لغو شد."

#: polyhost/device/hid_fw_up.py:90
#, python-brace-format
msgid "Chunk {n}/{total} ({kb} KB sent)…"
msgstr "قطعهٔ {n}/{total} ({kb} KB ارسال شد)…"

#: polyhost/device/hid_fw_up.py:92
#, python-brace-format
msgid "Keyboard halves resynced — rewinding to chunk {n}/{total} (offset {offset}, resync {resync})…"
msgstr "نیمه‌های صفحه‌کلید دوباره همگام شدند — بازگشت به قطعهٔ {n}/{total} (آفست {offset}، همگام‌سازی مجدد {resync})…"

#: polyhost/device/hid_fw_up.py:94
msgid "keyboard rejected the chunk"
msgstr "صفحه‌کلید قطعه را رد کرد"

#: polyhost/device/hid_fw_up.py:95
msgid "no reply from the keyboard"
msgstr "پاسخی از صفحه‌کلید نیامد"

#: polyhost/device/hid_fw_up.py:97
#, python-brace-format
msgid ""
"FW_UP_CHUNK failed at offset {offset} after {attempts} attempts — {reason}.\n"
"Ensure both keyboard halves are connected and running the same firmware, then try again — the update resumes from scratch and is safe to repeat."
msgstr ""
"FW_UP_CHUNK در آفست {offset} پس از {attempts} تلاش ناموفق بود — {reason}.\n"
"مطمئن شوید هر دو نیمهٔ صفحه‌کلید وصل هستند و میان‌افزار یکسانی اجرا می‌کنند، سپس دوباره امتحان کنید — به‌روزرسانی از ابتدا شروع می‌شود و تکرار آن بی‌خطر است."

#: polyhost/device/hid_fw_up.py:100
#, python-brace-format
msgid "Chunk {n}/{total} — retry {attempt}/{max_attempts} (waiting {ms} ms)…"
msgstr "قطعهٔ {n}/{total} — تلاش مجدد {attempt}/{max_attempts} (انتظار {ms} ms)…"

#: polyhost/device/hid_fw_up.py:101
#, python-brace-format
msgid "Sending over the fast link: {kb} KB of {total_kb} KB…"
msgstr "ارسال از طریق پیوند سریع: {kb} KB از {total_kb} KB…"

#: polyhost/device/hid_fw_up.py:102
#, python-brace-format
msgid "Fast link stopped ({reason}); continuing over HID from {kb} KB."
msgstr "پیوند سریع متوقف شد ({reason})؛ ادامه از طریق HID از {kb} KB."

#: polyhost/device/hid_fw_up.py:103
#, python-brace-format
msgid "Could not read {sig}: {error} — flashing unsigned."
msgstr "خواندن {sig} ممکن نشد: {error} — فلش بدون امضا انجام می‌شود."

#: polyhost/device/hid_fw_up.py:104
msgid "Sending image signature…"
msgstr "در حال ارسال امضای تصویر…"

#: polyhost/device/hid_fw_up.py:105
#, python-brace-format
msgid "Ignoring {sig} — expected {expected} bytes, got {size}."
msgstr "{sig} نادیده گرفته شد — {expected} بایت انتظار می‌رفت، {size} دریافت شد."

#: polyhost/device/hid_fw_up.py:106
msgid "Verifying the staged image (CRC32)…"
msgstr "در حال تأیید تصویر آماده‌شده (CRC32)…"

#: polyhost/device/hid_fw_up.py:108
msgid "This firmware is not signed. Confirm on the KEYBOARD: press the highlighted A (accept) or R (reject) key."
msgstr "این میان‌افزار امضا ندارد. روی صفحه‌کلید تأیید کنید: کلید برجسته‌شدهٔ A (پذیرش) یا R (رد) را فشار دهید."

#: polyhost/device/hid_fw_up.py:111
msgid ""
"Timed out waiting for confirmation on the keyboard.\n"
"\n"
"The keyboard asks for a physical ACCEPT/REJECT because this image is not validly signed. Start the flash again and press the highlighted A key on the left half within a minute."
msgstr ""
"زمان انتظار برای تأیید روی صفحه‌کلید به پایان رسید.\n"
"\n"
"صفحه‌کلید پذیرش/رد فیزیکی می‌خواهد چون این تصویر امضای معتبری ندارد. فلش را دوباره شروع کنید و ظرف یک دقیقه کلید برجسته‌شدهٔ A را روی نیمهٔ چپ فشار دهید."

#: polyhost/device/hid_fw_up.py:116
#, python-brace-format
msgid ""
"The keyboard refused this firmware: the signature does not match the image.\n"
"\n"
"{sig} is not a valid signature for this .bin. Either the two files come from different builds, or one of them is damaged — re-download both from the same release.\n"
"\n"
"There is deliberately no way to confirm past this on the keyboard: a signature that fails to verify means the file is not what it claims to be."
msgstr ""
"صفحه‌کلید این میان‌افزار را نپذیرفت: امضا با تصویر مطابقت ندارد.\n"
"\n"
"{sig} امضای معتبری برای این .bin نیست. یا این دو فایل از ساخت‌های متفاوتی هستند یا یکی از آن‌ها آسیب دیده است — هر دو را دوباره از همان نسخهٔ منتشرشده بارگیری کنید.\n"
"\n"
"عمداً هیچ راهی برای عبور از این مرحله با تأیید روی صفحه‌کلید وجود ندارد: امضایی که تأیید نشود یعنی فایل آن چیزی نیست که ادعا می‌کند."

#: polyhost/device/hid_fw_up.py:125
msgid ""
"The keyboard refused this firmware: it is not signed.\n"
"\n"
"Released firmware ships a matching '.sig' file — download it next to the .bin and flash again.\n"
"\n"
"To flash a build you compiled yourself, flash again and press the highlighted A (accept) key on the keyboard when it asks."
msgstr ""
"صفحه‌کلید این میان‌افزار را نپذیرفت: امضا ندارد.\n"
"\n"
"میان‌افزار منتشرشده همراه با فایل '.sig' متناظر عرضه می‌شود — آن را کنار فایل .bin بارگیری کنید و دوباره فلش کنید.\n"
"\n"
"برای فلش کردن نسخه‌ای که خودتان کامپایل کرده‌اید، دوباره فلش کنید و وقتی صفحه‌کلید پرسید، کلید برجستهٔ A (پذیرش) را فشار دهید."

#: polyhost/device/hid_fw_up.py:130
msgid "FW_UP_COMMIT failed — CRC mismatch on keyboard. Try again."
msgstr "FW_UP_COMMIT ناموفق بود — CRC روی صفحه‌کلید مطابقت ندارد. دوباره امتحان کنید."

#: polyhost/device/hid_fw_up.py:131
msgid "Done. New firmware staged and verified on the keyboard."
msgstr "انجام شد. میان‌افزار جدید روی صفحه‌کلید آماده و تأیید شد."

#: polyhost/device/hid_fw_up.py:133
msgid ""
"Firmware staged and verified successfully.\n"
"\n"
"The new image is stored and CRC-checked on the keyboard, but it is not active yet — the keyboard is still running its current firmware. Activating the staged image will be a separate step."
msgstr ""
"میان‌افزار با موفقیت آماده و تأیید شد.\n"
"\n"
"تصویر جدید روی صفحه‌کلید ذخیره و با CRC بررسی شده است، اما هنوز فعال نیست — صفحه‌کلید همچنان با میان‌افزار کنونی خود کار می‌کند. فعال‌سازی تصویر آماده‌شده مرحله‌ای جداگانه خواهد بود."

#: polyhost/device/hid_fw_up.py:137
msgid "Sending FW_UP_APPLY…"
msgstr "در حال ارسال FW_UP_APPLY…"

#: polyhost/device/hid_fw_up.py:139
msgid ""
"Apply is not available.\n"
"\n"
"The keyboard reported no valid staged image, or this firmware was built without in-app apply (FW_UP_INAPP_APPLY=no). The staged image is unchanged."
msgstr ""
"اعمال در دسترس نیست.\n"
"\n"
"صفحه‌کلید گزارش داد که تصویر آماده‌شدهٔ معتبری ندارد، یا این میان‌افزار بدون اعمال درون‌برنامه‌ای (FW_UP_INAPP_APPLY=no) ساخته شده است. تصویر آماده‌شده تغییری نکرده است."

#: polyhost/device/hid_fw_up.py:143
msgid "Applying — keyboard is erasing its flash and rebooting…"
msgstr "در حال اعمال — صفحه‌کلید حافظهٔ فلش خود را پاک می‌کند و دوباره راه‌اندازی می‌شود…"

#: polyhost/device/hid_fw_up.py:145
msgid ""
"Keyboard did not reconnect within 30 s after apply.\n"
"If it does not come back on its own, hold BOOTSEL on the master half and re-flash the .uf2."
msgstr ""
"صفحه‌کلید پس از اعمال در 30 s دوباره وصل نشد.\n"
"اگر خودبه‌خود برنگشت، BOOTSEL را روی نیمهٔ اصلی نگه دارید و فایل .uf2 را دوباره فلش کنید."

#: polyhost/device/hid_fw_up.py:149
msgid ""
"The keyboard acknowledged APPLY but did not reboot within 10 s.\n"
"The staged image was not applied; the keyboard still runs its current firmware. Try the apply again."
msgstr ""
"صفحه‌کلید APPLY را تأیید کرد اما در 10 s دوباره راه‌اندازی نشد.\n"
"تصویر آماده‌شده اعمال نشد؛ صفحه‌کلید همچنان با میان‌افزار کنونی خود کار می‌کند. اعمال را دوباره امتحان کنید."

#: polyhost/device/hid_fw_up.py:152
msgid "Done. Keyboard reconnected on the applied firmware."
msgstr "انجام شد. صفحه‌کلید با میان‌افزار اعمال‌شده دوباره وصل شد."

#: polyhost/device/hid_fw_up.py:154
msgid ""
"Firmware applied — the keyboard rebooted and reconnected.\n"
"\n"
"Both halves now run the new firmware."
msgstr ""
"میان‌افزار اعمال شد — صفحه‌کلید دوباره راه‌اندازی و وصل شد.\n"
"\n"
"اکنون هر دو نیمه میان‌افزار جدید را اجرا می‌کنند."

#: polyhost/device/split_link.py:30
#, python-brace-format
msgid "{prefix} — the USB half answered, but the other keyboard half did not confirm that it had erased the {what} within 90 s. Check the cable between the two halves. If the other half stays dark, it is not running firmware and needs the firmware .uf2 copied onto it by hand."
msgstr "{prefix} — نیمهٔ USB پاسخ داد، اما نیمهٔ دیگر صفحه‌کلید تأیید نکرد که {what} را در 90 s پاک کرده است. کابل بین دو نیمه را بررسی کنید. اگر نیمهٔ دیگر خاموش بماند، میان‌افزاری اجرا نمی‌کند و باید فایل .uf2 میان‌افزار را به‌صورت دستی روی آن کپی کرد."

#: polyhost/forwarder.py:243
msgid "Press to pause forwarding"
msgstr "برای مکث ارسال کلیک کنید"

#: polyhost/forwarder.py:250
msgid "Stop sending this machine's active window to the keyboard machine."
msgstr "ارسال پنجرهٔ فعال این رایانه به رایانهٔ صفحه‌کلید متوقف شود."

#: polyhost/forwarder.py:262
msgid "Check for host update…"
msgstr "بررسی به‌روزرسانی میزبان…"

#: polyhost/forwarder.py:343
#, python-brace-format
msgid "no host (waiting for {path})"
msgstr "بدون میزبان (در انتظار {path})"

#: polyhost/forwarder.py:344
msgid "no host configured"
msgstr "میزبانی پیکربندی نشده است"

#: polyhost/forwarder.py:347
#, python-brace-format
msgid "PolyKybdHost {version} (forwarder) → {target}"
msgstr "PolyKybdHost {version} (ارسال‌کننده) → {target}"

#: polyhost/forwarder.py:352
msgid "Forwarding paused"
msgstr "ارسال متوقف شد"

#: polyhost/forwarder.py:355
#, python-brace-format
msgid "Forwarding to {target}…"
msgstr "در حال ارسال به {target}…"

#: polyhost/forwarder.py:357
#, python-brace-format
msgid "Forwarding to {target}"
msgstr "ارسال به {target}"

#: polyhost/forwarder.py:358
#, python-brace-format
msgid "Cannot reach {target}"
msgstr "دسترسی به {target} ممکن نیست"

#: polyhost/forwarder.py:751
msgid "PolyForwarder settings"
msgstr "تنظیمات PolyForwarder"

#: polyhost/forwarder.py:752
msgid "The settings could not be saved to the settings file, so they will not take effect. Another program may be holding it open. Try again, or see the log."
msgstr "تنظیمات در فایل تنظیمات ذخیره نشد، بنابراین اعمال نخواهد شد. ممکن است برنامهٔ دیگری آن را باز نگه داشته باشد. دوباره تلاش کنید یا لاگ را ببینید."

#: polyhost/forwarder.py:771
#, python-brace-format
msgid "authenticated RPC (port {port})"
msgstr "RPC احراز هویت‌شده (درگاه {port})"

#: polyhost/forwarder.py:773
msgid "legacy plaintext TCP relay"
msgstr "رلهٔ قدیمی TCP متن ساده"

